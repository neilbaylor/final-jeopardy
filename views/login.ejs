<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="apple-mobile-web-app-title" content="FJ Friends" />
  <meta name="theme-color" content="#07102e" />
  <link rel="manifest" href="/manifest.json" />
  <link rel="apple-touch-icon" href="/images/logo.jpeg" />
  <title>Final Jeopardy! With Friends</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      background: #07102e;
      height: 100vh;
      height: 100dvh;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      align-items: center;
      font-family: 'Segoe UI', system-ui, sans-serif;
      padding: env(safe-area-inset-top, 0px) env(safe-area-inset-right, 0px) env(safe-area-inset-bottom, 0px) env(safe-area-inset-left, 0px);
    }

    .logo-wrap {
      margin-top: 10vh;
      opacity: 0;
      animation: fadeIn 0.15s ease forwards;
    }

    .logo {
      width: min(340px, 88vw);
      border-radius: 24px;
      display: block;
      -webkit-mask-image: linear-gradient(to bottom, black 72%, transparent 100%);
      mask-image: linear-gradient(to bottom, black 72%, transparent 100%);
    }

    .btn-area {
      margin-top: auto;
      margin-bottom: max(env(safe-area-inset-bottom, 0px) + 2rem, 6rem);
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.75rem;
      opacity: 0;
      animation: fadeIn 0.15s ease forwards;
      animation-delay: 0.45s;
    }

    @keyframes fadeIn {
      to { opacity: 1; }
    }

    .error {
      color: #ff6b6b;
      font-size: 0.9rem;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.6rem;
      padding: 0.85rem 2rem;
      border-radius: 12px;
      text-decoration: none;
      font-size: 1rem;
      font-weight: 600;
      transition: opacity 0.2s, transform 0.15s;
      -webkit-tap-highlight-color: transparent;
      user-select: none;
    }

    .btn:active { transform: scale(0.96); opacity: 0.85; }

    .btn-google {
      background: #ffffff;
      color: #333;
      width: min(340px, 85vw);
      padding: 1.2rem 2rem;
    }

    .btn-google img { width: 20px; height: 20px; }

    .btn-play {
      background: #FFD700;
      color: #111;
      font-size: 1.3rem;
      font-weight: 700;
      letter-spacing: 2px;
      width: min(340px, 85vw);
      padding: 1.3rem 2rem;
      border-radius: 14px;
      text-transform: uppercase;
    }

    .install-hint {
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      background: rgba(255,255,255,0.08);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border-top: 1px solid rgba(255,255,255,0.12);
      padding: 0.85rem 1.5rem max(env(safe-area-inset-bottom, 0px), 0.85rem);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.75rem;
      font-size: 0.85rem;
      color: rgba(255,255,255,0.85);
      animation: slideUp 0.3s ease forwards;
    }

    @keyframes slideUp {
      from { transform: translateY(100%); }
      to   { transform: translateY(0); }
    }

    .install-hint span { flex: 1; line-height: 1.4; }

    .install-hint button {
      background: #FFD700;
      color: #111;
      border: none;
      border-radius: 8px;
      padding: 0.5rem 1rem;
      font-weight: 700;
      font-size: 0.85rem;
      cursor: pointer;
      white-space: nowrap;
      -webkit-tap-highlight-color: transparent;
    }

    .install-hint .dismiss {
      background: none;
      color: rgba(255,255,255,0.5);
      padding: 0.5rem;
      font-size: 1.1rem;
    }
  </style>
</head>
<body>
  <div class="logo-wrap">
    <img src="/images/logo.jpeg" alt="Final Jeopardy! With Friends" class="logo" />
  </div>

  <div class="btn-area">
    <% if (error) { %>
      <p class="error">Sign-in failed. Please try again.</p>
    <% } %>

    <a href="/auth/google" class="btn btn-google" id="btn-google">
      <img src="/images/google-icon.svg" alt="Google" />
      Sign in with Google
    </a>
    <a href="/dashboard" class="btn btn-play" id="btn-play" style="display:none">Play</a>
  </div>

  <script>
    if ('serviceWorker' in navigator) {
      navigator.serviceWorker.register('/sw.js');
    }

    // After OAuth redirect: store userId in localStorage and clean the URL
    const params = new URLSearchParams(location.search);
    const uid = params.get('uid');
    if (uid) {
      localStorage.setItem('userId', uid);
      location.replace('/dashboard');
    }

    // Show Play button if already signed in
    if (localStorage.getItem('userId')) {
      document.getElementById('btn-google').style.display = 'none';
      document.getElementById('btn-play').style.display = '';
    }

    // Add to Home Screen prompt
    const isStandalone = window.matchMedia('(display-mode: standalone)').matches || window.navigator.standalone;
    const dismissed = sessionStorage.getItem('installDismissed');

    if (!isStandalone && !dismissed) {
      const isIOS = /iphone|ipad|ipod/i.test(navigator.userAgent);
      let deferredPrompt = null;

      function showHint(label, onClick) {
        const hint = document.createElement('div');
        hint.className = 'install-hint';
        hint.innerHTML = `
          <span>${label}</span>
          <button id="install-btn">${isIOS ? 'How?' : 'Install'}</button>
          <button class="dismiss" aria-label="Dismiss">✕</button>
        `;
        document.body.appendChild(hint);
        hint.querySelector('#install-btn').addEventListener('click', onClick);
        hint.querySelector('.dismiss').addEventListener('click', () => {
          sessionStorage.setItem('installDismissed', '1');
          hint.remove();
        });
      }

      if (isIOS) {
        showHint('Add this app to your Home Screen for the best experience.', () => {
          alert('Tap the Share button (□↑) in Safari, then choose "Add to Home Screen".');
        });
      } else {
        window.addEventListener('beforeinstallprompt', (e) => {
          e.preventDefault();
          deferredPrompt = e;
          showHint('Add Final Jeopardy! to your Home Screen.', async () => {
            deferredPrompt.prompt();
            await deferredPrompt.userChoice;
            deferredPrompt = null;
            document.querySelector('.install-hint')?.remove();
          });
        });
      }
    }
  </script>
</body>
</html>
