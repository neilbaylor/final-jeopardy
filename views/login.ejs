<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="default" />
  <meta name="apple-mobile-web-app-title" content="Final Jeopardy" />
  <meta name="theme-color" content="#07102e" />
  <link rel="manifest" href="/manifest.json" />
  <link rel="icon" type="image/x-icon" href="/images/favicon.ico" />
  <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32x32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/images/favicon-16x16.png" />
  <link rel="apple-touch-icon" href="/images/hone-screen-new.png" />
  <title>Final Jeopardy With Friends</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      touch-action: manipulation;
      background: #07102e;
      height: 100vh;
      height: 100dvh;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      align-items: center;
      font-family: 'Segoe UI', system-ui, sans-serif;
      padding: env(safe-area-inset-top, 0px) env(safe-area-inset-right, 0px) env(safe-area-inset-bottom, 0px) env(safe-area-inset-left, 0px);
    }

    .logo-wrap {
      margin-top: 10vh;
      opacity: 0;
      transition: opacity 0.7s ease;
      transition-delay: 0.35s;
    }

    .logo {
      width: min(340px, 88vw);
      border-radius: 24px;
      display: block;
      -webkit-mask-image: linear-gradient(to bottom, transparent 0%, black 16%, black 84%, transparent 100%);
      mask-image: linear-gradient(to bottom, transparent 0%, black 16%, black 84%, transparent 100%);
    }

    .btn-area {
      margin-top: auto;
      margin-bottom: max(env(safe-area-inset-bottom, 0px) + 2rem, 6rem);
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.75rem;
      opacity: 0;
      animation: fadeIn 1.0s ease forwards;
      animation-delay: 0.75s;
    }

    @keyframes fadeIn {
      to { opacity: 1; }
    }

    .error {
      color: #ff6b6b;
      font-size: 0.9rem;
    }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.6rem;
      padding: 0.85rem 2rem;
      border-radius: 12px;
      text-decoration: none;
      font-size: 1rem;
      font-weight: 600;
      transition: opacity 0.2s, transform 0.15s;
      -webkit-tap-highlight-color: transparent;
      user-select: none;
    }

    .btn:active { transform: scale(0.96); opacity: 0.85; }

    .btn-google {
      background: #ffffff;
      color: #333;
      width: min(340px, 85vw);
      padding: 1.2rem 2rem;
      position: relative;
    }

    .btn-google img { width: 20px; height: 20px; }

    .btn-google-spin {
      position: absolute;
      right: 1.2rem;
      width: 20px;
      height: 20px;
      border: 2px solid rgba(0,0,0,0.15);
      border-top-color: #555;
      border-radius: 50%;
      animation: googleBtnSpin 0.7s linear infinite;
    }
    @keyframes googleBtnSpin { to { transform: rotate(360deg); } }

    .btn-play {
      background: #FFD700;
      color: #111;
      font-size: 1.3rem;
      font-weight: 700;
      letter-spacing: 2px;
      width: min(340px, 85vw);
      padding: 1.3rem 2rem;
      border-radius: 14px;
      text-transform: uppercase;
    }

    .install-hint {
      position: fixed;
      bottom: 0;
      left: 0;
      right: 0;
      background: rgba(255,255,255,0.08);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border-top: 1px solid rgba(255,255,255,0.12);
      padding: 0.85rem 1.5rem max(env(safe-area-inset-bottom, 0px), 0.85rem);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.75rem;
      font-size: 0.85rem;
      color: rgba(255,255,255,0.85);
      animation: slideUp 0.3s ease forwards;
    }

    @keyframes slideUp {
      from { transform: translateY(100%); }
      to   { transform: translateY(0); }
    }

    .install-hint span { flex: 1; line-height: 1.4; }

    .install-hint button {
      background: #FFD700;
      color: #111;
      border: none;
      border-radius: 8px;
      padding: 0.5rem 1rem;
      font-weight: 700;
      font-size: 0.85rem;
      cursor: pointer;
      white-space: nowrap;
      -webkit-tap-highlight-color: transparent;
    }

    .install-hint .dismiss {
      background: none;
      color: rgba(255,255,255,0.5);
      padding: 0.5rem;
      font-size: 1.1rem;
    }

    /* Opt in to MPA view transitions (destination controls the animation) */
    @view-transition { navigation: auto; }

    #welcome-overlay {
      position: fixed;
      inset: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 28px;
      opacity: 0;
      transition: opacity 0.22s ease;
      pointer-events: none;
      z-index: 10;
      padding-bottom: 260px;
    }
    #welcome-avatar {
      opacity: 0;
      transition: opacity 0.5s ease;
    }
    #welcome-avatar img {
      width: 88px;
      height: 88px;
      border-radius: 50%;
      object-fit: cover;
      border: 3px solid rgba(255,255,255,0.35);
      display: block;
    }
    .welcome-avatar-ph {
      width: 88px;
      height: 88px;
      border-radius: 50%;
      background: rgba(255,255,255,0.15);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 2.4rem;
    }
    #welcome-name {
      opacity: 0;
      transition: opacity 0.5s ease;
      color: #fff;
      font-size: 1.2rem;
      font-weight: 400;
      letter-spacing: 0.01em;
    }
    #install-modal-backdrop {
      display: flex;
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,0.45);
      z-index: 200;
      align-items: center;
      justify-content: center;
      padding: 24px;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.2s ease;
    }
    #install-modal-backdrop.open {
      opacity: 1;
      pointer-events: auto;
    }
    #install-modal {
      background: #fff;
      border-radius: 16px;
      padding: 18px 16px 14px;
      max-width: 400px;
      width: 100%;
      box-shadow: 0 8px 32px rgba(0,0,0,0.22);
      text-align: center;
    }
    #install-modal p {
      font-size: 1.05rem;
      font-weight: 600;
      color: #111;
      line-height: 1.45;
      margin-bottom: 14px;
    }
    #install-modal-ok {
      background: #07102e;
      color: #fff;
      border: none;
      border-radius: 999px;
      padding: 0 28px;
      height: 38px;
      font-family: 'Segoe UI', system-ui, sans-serif;
      font-size: 0.9rem;
      font-weight: 700;
      cursor: pointer;
      -webkit-tap-highlight-color: transparent;
      margin-top: 10px;
    }
  </style>
</head>
<body>
  <div id="welcome-overlay">
    <div id="welcome-avatar"></div>
    <div id="welcome-name"></div>
  </div>
  <div class="logo-wrap">
    <img src="data:image/jpeg;base64," alt="Final Jeopardy! With Friends" class="logo" />
  </div>

  <div class="btn-area">
    <% if (error) { %>
      <p class="error">Sign-in failed. Please try again.</p>
    <% } %>

    <a href="/auth/google" class="btn btn-google" id="btn-google">
      <img src="/images/google-icon.svg" alt="Google" />
      Sign in with Google
    </a>
    <a href="/dashboard" class="btn btn-play" id="btn-play" style="display:none">Play</a>
  </div>

  <script>
    document.addEventListener('touchmove', (e) => { if (e.touches.length > 1) e.preventDefault(); }, { passive: false });

    // Reset Google button if user navigates back via browser back button
    window.addEventListener('pageshow', (e) => {
      if (e.persisted) {
        const btn = document.getElementById('btn-google');
        btn.classList.remove('btn-clicked');
        btn.style.opacity = '';
        btn.style.pointerEvents = '';
        btn.querySelector('.btn-google-spin')?.remove();
      }
    });

    // Disable Google sign-in button after click to prevent double-taps
    document.getElementById('btn-google').addEventListener('click', function(e) {
      if (this.classList.contains('btn-clicked')) { e.preventDefault(); return; }
      this.classList.add('btn-clicked');
      this.style.opacity = '0.5';
      this.style.pointerEvents = 'none';
      const spin = document.createElement('span');
      spin.className = 'btn-google-spin';
      this.appendChild(spin);
    });
    if ('serviceWorker' in navigator) {
      navigator.serviceWorker.register('/sw.js');
    }

    // After OAuth redirect: store userId in localStorage, show welcome, then navigate
    const params = new URLSearchParams(location.search);
    const uid = params.get('uid');
    const isNew = params.get('new') === '1';
    if (uid) {
      document.querySelector('.btn-area').style.visibility = 'hidden';
      localStorage.setItem('userId', uid);
      history.replaceState(null, '', '/');
      fetch('/api/me?userId=' + encodeURIComponent(uid))
        .then(r => r.ok ? r.json() : null)
        .then(user => {
          if (user) {
            const firstName = user.display_name ? user.display_name.trim().split(' ')[0] : '';
            const greeting = isNew ? 'Welcome' : 'Welcome back';
            document.getElementById('welcome-avatar').innerHTML = user.avatar_url
              ? `<img src="${user.avatar_url}" alt="${user.display_name}" />`
              : `<div class="welcome-avatar-ph">👤</div>`;
            document.getElementById('welcome-name').textContent = firstName ? `${greeting}, ${firstName}!` : `${greeting}!`;
          }
          document.getElementById('welcome-overlay').style.opacity = '1';
          setTimeout(() => {
            document.getElementById('welcome-avatar').style.opacity = '1';
            document.getElementById('welcome-name').style.opacity = '1';
          }, 250);
          setTimeout(() => location.replace('/dashboard'), 1825);
        })
        .catch(() => location.replace('/dashboard'));
    }

    // Trigger logo fade-in only when not showing the welcome overlay
    if (!uid) {
      setTimeout(() => {
        document.querySelector('.logo-wrap').style.opacity = '1';
      }, 100);
    }

    // Verify stored userId against API before showing Play button
    const storedId = localStorage.getItem('userId');
    if (storedId) {
      fetch('/api/me?userId=' + encodeURIComponent(storedId))
        .then(r => {
          if (r.ok) {
            document.getElementById('btn-google').style.display = 'none';
            document.getElementById('btn-play').style.display = '';
          } else {
            localStorage.removeItem('userId');
          }
        })
        .catch(() => {
          document.getElementById('btn-google').style.display = 'none';
          document.getElementById('btn-play').style.display = '';
        });
    }

    // Add to Home Screen prompt
    const isStandalone = window.matchMedia('(display-mode: standalone)').matches || window.navigator.standalone;
    const dismissed = sessionStorage.getItem('installDismissed');

    const isMobile = /iphone|ipad|ipod|android|mobile/i.test(navigator.userAgent);
    if (isMobile && !isStandalone && !dismissed && !uid) {
      const isIOS = /iphone|ipad|ipod/i.test(navigator.userAgent);
      let deferredPrompt = null;

      function showHint(label, onClick) {
        const hint = document.createElement('div');
        hint.className = 'install-hint';
        hint.innerHTML = `
          <span>${label}</span>
          <button id="install-btn">${isIOS ? 'How?' : 'Install'}</button>
          <button class="dismiss" aria-label="Dismiss">✕</button>
        `;
        document.body.appendChild(hint);
        hint.querySelector('#install-btn').addEventListener('click', onClick);
        hint.querySelector('.dismiss').addEventListener('click', () => {
          sessionStorage.setItem('installDismissed', '1');
          hint.remove();
        });
      }

      if (isIOS) {
        setTimeout(() => {
          showHint('Add this app to your Home Screen for the best experience.', () => {
            document.getElementById('install-modal-backdrop').classList.add('open');
          });
        }, 1300);
      } else {
        window.addEventListener('beforeinstallprompt', (e) => {
          e.preventDefault();
          deferredPrompt = e;
          setTimeout(() => {
            showHint('Add Final Jeopardy! to your Home Screen.', async () => {
              deferredPrompt.prompt();
              await deferredPrompt.userChoice;
              deferredPrompt = null;
              document.querySelector('.install-hint')?.remove();
            });
          }, 1300);
        });
      }
    }

  </script>
  <div id="install-modal-backdrop">
    <div id="install-modal">
      <p>Tap the Share button in Safari, then choose &ldquo;Add to Home Screen&rdquo;.</p>
      <button id="install-modal-ok">OK</button>
    </div>
  </div>
  <script>
    document.getElementById('install-modal-ok').addEventListener('click', () => {
      document.getElementById('install-modal-backdrop').classList.remove('open');
    });
  </script>
</body>
</html>
