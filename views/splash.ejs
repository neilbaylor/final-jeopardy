<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="default" />
  <meta name="apple-mobile-web-app-title" content="Final Jeopardy" />
  <meta name="theme-color" content="#07102e" />
  <link rel="manifest" href="/manifest.json" />
  <link rel="apple-touch-icon" href="/images/hone-screen-new.png" />
  <title>Final Jeopardy with Friends</title>
  <style>
    html, body {
      margin: 0;
      padding: 0;
    }
    body {
      -webkit-text-size-adjust: 100%;
      text-size-adjust: 100%;
      touch-action: pan-x pan-y;
      background: #07102e;
      height: 100vh;
      height: 100dvh;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      align-items: center;
      font-family: 'Segoe UI', 'Google Sans', system-ui, sans-serif;
      padding: env(safe-area-inset-top, 0px) env(safe-area-inset-right, 0px) env(safe-area-inset-bottom, 0px) env(safe-area-inset-left, 0px);
    }
    #host {
      position: fixed;
      top: 190px;
      left: 50%;
      transform: translateX(-50%);
      width: 264px;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.15s ease;
    }
    #host img {
      width: 100%;
      display: block;
      -webkit-mask-image: linear-gradient(to bottom, transparent 0%, black 16%, black 84%, transparent 100%),
                          linear-gradient(to right, transparent 0%, black 12%, black 88%, transparent 100%);
      -webkit-mask-composite: destination-in;
      mask-image: linear-gradient(to bottom, transparent 0%, black 16%, black 84%, transparent 100%),
                  linear-gradient(to right, transparent 0%, black 12%, black 88%, transparent 100%);
      mask-composite: intersect;
    }
  </style>
</head>
<body>
  <div id="host"><img alt="" id="splash-img" /></div>
  <script>
    var hosts = ['host_pointing', 'host_money_mic', 'host_mic_presenting', 'host_magician', 'host_flirty'];
    var img = document.getElementById('splash-img');
    img.src = '/images/' + hosts[Math.floor(Math.random() * hosts.length)] + '.png';
    var start = Date.now();
    img.onload = function() {
      var host = document.getElementById('host');
      host.style.opacity = '0.8';
      var elapsed = Date.now() - start;
      var remaining = Math.max(0, 1400 - elapsed);
      setTimeout(function() {
        host.style.transition = 'opacity 0.4s linear';
        host.style.opacity = '0';
        setTimeout(function() { window.location.replace('/'); }, 400);
      }, remaining - 400);
    };
  </script>
</body>
</html>
