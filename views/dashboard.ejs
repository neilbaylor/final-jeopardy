<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="theme-color" content="#07102e" />
  <link rel="manifest" href="/manifest.json" />
  <title>Final Jeopardy! With Friends</title>
  <script>
    // Must run before first paint so the class is set before CSS is applied.
    window.addEventListener('pagereveal', e => {
      if (e.viewTransition) document.documentElement.classList.add('vt-entry');
    });
  </script>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      background: #fff;
      height: 100vh;
      height: 100dvh;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      font-family: 'Segoe UI', system-ui, sans-serif;
      color: #111;
    }

    .topbar {
      background: #07102e;
      display: flex;
      align-items: center;
      justify-content: flex-start;
      padding-top: calc(env(safe-area-inset-top, 0px) + 12px);
      padding-bottom: 8px;
      padding-left: calc(env(safe-area-inset-left, 0px) + 14px);
      padding-right: 14px;
      min-height: calc(env(safe-area-inset-top, 0px) + 56px);
      flex-shrink: 0;
      box-shadow: 0 2px 8px rgba(0,0,0,0.25);
    }

    .avatar {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      object-fit: cover;
      border: 2px solid rgba(255,255,255,0.2);
    }

    .avatar-placeholder {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      background: rgba(255,255,255,0.15);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.1rem;
    }

    .topbar-user {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .topbar-greeting {
      font-size: 0.8rem;
      color: rgba(255,255,255,0.85);
      font-weight: 400;
    }

    .spinner {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      border: 2px solid rgba(255,255,255,0.15);
      border-top-color: rgba(255,255,255,0.55);
      animation: spin 0.7s linear infinite;
    }

    @keyframes spin {
      to { transform: rotate(360deg); }
    }

    .content {
      flex: 1;
      overflow-y: auto;
      padding: 20px 16px;
    }

    .fab {
      position: fixed;
      bottom: calc(env(safe-area-inset-bottom, 0px) + 24px);
      right: calc(env(safe-area-inset-right, 0px) + 20px);
      height: 48px;
      border-radius: 999px;
      background: rgba(255, 213, 0, 0.88);
      border: none;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      padding: 0 18px 0 14px;
      box-shadow: 0 4px 14px rgba(0,0,0,0.18);
      transition: transform 0.15s ease, opacity 0.15s ease;
      -webkit-tap-highlight-color: transparent;
      font-family: 'Segoe UI', system-ui, sans-serif;
      font-size: 0.9rem;
      font-weight: 600;
      color: #07102e;
    }

    .fab:active {
      transform: scale(0.93);
      opacity: 0.8;
    }

    .fab svg {
      width: 24px;
      height: 24px;
      stroke: #07102e;
      stroke-width: 2.5;
      stroke-linecap: round;
    }

    .topbar, .fab {
      opacity: 0;
      animation: fadeIn 0.25s ease forwards;
      animation-delay: 0.1s;
    }

    @keyframes fadeIn {
      to { opacity: 1; }
    }

    .fab { animation-delay: 0.18s; }

    /* MPA View Transition: login slides down, dashboard is revealed behind it */
    @view-transition { navigation: auto; }

    @keyframes slide-down {
      to { transform: translateY(100dvh); }
    }

    ::view-transition-old(root) {
      animation: slide-down 0.3s ease-in both;
    }
    ::view-transition-new(root) {
      animation: none;
    }

    /* When arriving via a view transition, skip the topbar/fab fade-in so the
       transition screenshot captures them at full opacity (no flicker). */
    :root.vt-entry .topbar,
    :root.vt-entry .fab {
      animation: none;
      opacity: 1;
    }
  </style>
</head>
<body>
  <div class="topbar">
    <div class="topbar-user">
      <div id="avatar-wrap"><div class="spinner"></div></div>
      <span id="topbar-greeting" class="topbar-greeting" style="display:none"></span>
    </div>
  </div>

  <div class="content" id="content"></div>

  <button class="fab" id="new-game" aria-label="New game">
    <svg viewBox="0 0 24 24" fill="none"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
    New Game
  </button>

  <script>
    const userId = localStorage.getItem('userId');
    if (!userId) {
      location.replace('/');
    } else {
      fetch(`/api/me?userId=${encodeURIComponent(userId)}`)
        .then(r => r.ok ? r.json() : Promise.reject())
        .then(user => {
          const wrap = document.getElementById('avatar-wrap');
          wrap.innerHTML = user.avatar_url
            ? `<img class="avatar" src="${user.avatar_url}" alt="${user.display_name}" />`
            : `<div class="avatar-placeholder">👤</div>`;
          const firstName = user.display_name ? user.display_name.trim().split(' ')[0] : '';
          if (firstName) {
            const greeting = document.getElementById('topbar-greeting');
            greeting.textContent = `Hi, ${firstName}!`;
            greeting.style.display = '';
          }
        })
        .catch(() => location.replace('/'));
    }

    document.getElementById('new-game').addEventListener('click', () => {
      // TODO: navigate to new game flow
    });
  </script>
</body>
</html>
