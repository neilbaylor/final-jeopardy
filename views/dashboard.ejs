        <span id="topbar-greeting" class="topbar-greeting" style="display:none"></span>
        <div id="user-popover">
          <button id="stats-btn">Stats<div id="stats-btn-icon"><svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg></div></button>
          <button id="logout-btn">Logout<svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg></button>
        </div>
      </div>
    </div>

    <div id="games-ptr-indicator"><div id="games-ptr-spinner"></div></div>
    <div class="content" id="content">
      <div id="games-container">
        <h2 class="games-title">Your Games</h2>
        <div id="games-spinner" class="hidden"><div class="panel-spin"></div></div>
        <div id="games-list"></div>
      </div>
    </div>

    <button class="fab" id="new-game" aria-label="New game" style="opacity:0">
      <svg viewBox="0 0 24 24" fill="none"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
      New Game
    </button>

  <div id="new-game-panel">
    <div id="panel-header">
      <button id="close-panel" aria-label="Back">
        <svg viewBox="0 0 24 24" fill="none"><polyline points="15 18 9 12 15 6"/></svg>
      </button>
      <span id="panel-title">Select Friends For a Game</span>
      <button id="create-btn" disabled><span class="btn-text">Create</span><div class="btn-spinner"></div></button>
    </div>
    <div id="panel-spinner"><div class="panel-spin"></div></div>
    <div id="ptr-indicator"><div id="ptr-spinner"></div></div>
    <div id="users-list-wrap"><div id="users-list"><div id="users-list-scroller"></div></div></div>
  </div>
  </div>

  <div id="delete-modal-backdrop">
    <div id="delete-modal">
      <p>Are you sure you want to delete this game?</p>
      <div class="delete-modal-buttons">
        <button id="delete-modal-cancel">Cancel</button>
        <button id="delete-modal-confirm"><span class="dm-text">Yes</span><div class="dm-spinner"></div></button>
      </div>
    </div>
  </div>

  <div id="delete-user-modal-backdrop">
    <div id="delete-user-modal">
      <p id="delete-user-modal-msg">Are you sure you want to delete this user?</p>
      <div class="delete-modal-buttons">
        <button id="delete-user-modal-cancel">Cancel</button>
        <button id="delete-user-modal-confirm"><span class="du-text">Delete</span><div class="du-spinner"></div></button>
      </div>
    </div>
  </div>

  <div id="error-modal-backdrop">
    <div id="error-modal">
      <p id="error-modal-msg"></p>
      <button id="error-modal-ok">OK</button>
    </div>
  </div>

  <div id="stats-modal-backdrop">
    <div id="stats-modal">
      <div id="stats-modal-header-text"></div>
      <div id="stats-modal-subheading"></div>
      <div id="stats-modal-content">
        <div class="player-avatar-wrap">
          <div id="stats-modal-avatar"></div>
          <div id="stats-modal-coin" class="coin player-score-coin coin-shimmer"></div>
        </div>
        <div class="game-player-info">
          <span id="stats-modal-name" class="player-name"></span>
          <span id="stats-modal-stat" class="player-status waiting"></span>
        </div>
      </div>
      <div id="stats-modal-streaks"></div>
    </div>
  </div>

  <div id="view-modal-backdrop">
    <div id="view-modal">
      <div id="view-modal-header">
        <div id="view-modal-category"></div>
        <div id="view-modal-question"></div>
        <div id="view-modal-answer"></div>
      </div>
      <div id="view-modal-content"></div>
      <div id="view-modal-footer"></div>
    </div>
  </div>

  <script>
    document.addEventListener('touchmove', (e) => { if (e.touches.length > 1) e.preventDefault(); }, { passive: false });
    const userId = localStorage.getItem('userId');
    const GAMES_CACHE_KEY = `fjwf_games_${userId}`;
    let prevGameIds = null;
    let lastLoadedAt = Date.now();
    let cardSwiping = false;
    function getCachedGames() {
      try {
        const parsed = JSON.parse(localStorage.getItem(GAMES_CACHE_KEY) || 'null');
        if (!parsed || !Array.isArray(parsed.games) || parsed.games.length === 0) return null;
        if (Date.now() - parsed.savedAt > 15 * 60 * 1000) return null;
        return parsed.games;
      } catch { return null; }
    }
    let currentUser = null;
    let currentGames = [];
    // Register push subscription; renew once per day
    const isPWA = window.navigator.standalone || window.matchMedia('(display-mode: standalone)').matches;
    if (isPWA && 'Notification' in window && 'PushManager' in window && Notification.permission === 'granted') {
      const PUSH_RENEWED_KEY = `push_renewed_${userId}`;
      const lastRenewed = localStorage.getItem(PUSH_RENEWED_KEY);
      const oneDayAgo = Date.now() - 86400000;
      const needsRenewal = !lastRenewed || Number(lastRenewed) < oneDayAgo;
      navigator.serviceWorker.ready.then(sw => sw.pushManager.getSubscription().then(existing => {
        if (existing && !needsRenewal) return; // subscribed and fresh
        return sw.pushManager.subscribe({
          userVisibleOnly: true,
          applicationServerKey: '<%= process.env.VAPID_PUBLIC_KEY || "" %>',
        }).then(sub => {
          const uid = localStorage.getItem('userId');
          if (!uid) return;
          fetch('/api/push-subscription', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ userId: uid, subscription: sub }),
          }).then(() => {
            localStorage.setItem(PUSH_RENEWED_KEY, String(Date.now()));
          }).catch(() => {});
        });
      })).catch(() => {});
    }

    if (!userId) {
      location.replace('/');
    } else {
      const mePromise = fetch(`/api/me?userId=${encodeURIComponent(userId)}`)
        .then(r => r.ok ? r.json() : Promise.reject())
        .then(user => {
          currentUser = user;
          const wrap = document.getElementById('avatar-wrap');
          wrap.innerHTML = user.avatar_url
            ? `<img class="avatar" src="${user.avatar_url}" alt="${user.display_name}" />`
            : `<div class="avatar-placeholder">👤</div>`;
          const parts = user.display_name ? user.display_name.trim().split(' ') : [];
          const firstName = parts[0] || '';
          const initials = parts.length >= 2 ? parts[0][0].toUpperCase() + parts[parts.length - 1][0].toUpperCase() : (parts[0] ? parts[0][0].toUpperCase() : '');
          if (firstName) {
            const greeting = document.getElementById('topbar-greeting');
            const label = firstName.length <= 7 ? firstName : initials;
            greeting.textContent = `Hi, ${label}`;
            greeting.style.display = '';
          }
        })
        .catch(() => location.replace('/'));

      const cachedGames = getCachedGames();
      if (cachedGames) {
        // If fresh data arrives before the cache delay fires, render it directly (no double flash).
        // If it arrives after, re-render normally as a background refresh.
        let cacheTimerFired = false;
        let pendingGames = null;

        // Check both the class (set by pagereveal, Safari 18.2+) and sessionStorage
        // directly as a fallback for older Safari where pagereveal doesn't fire.
        // Do NOT remove sessionStorage here — pagereveal must read it to set the
        // CSS transition class, and body script can race ahead of pagereveal.
        const fromGame  = document.documentElement.classList.contains('vt-from-game')  || !!sessionStorage.getItem('vt-from-game');
        const fromLogin = document.documentElement.classList.contains('vt-from-login') || !!sessionStorage.getItem('vt-from-login');
        const cacheDelay = fromGame ? 470 : fromLogin ? 415 : 350;
        Promise.all([mePromise, new Promise(res => setTimeout(res, cacheDelay))]).then(() => {
          cacheTimerFired = true;
          renderGames(pendingGames || cachedGames);
          const fab = document.getElementById('new-game');
          setTimeout(() => { fab.style.opacity = '1'; }, 650);
        });
        // Background refresh — new games get the green fade-in via new-row class
        fetch(`/api/games?userId=${encodeURIComponent(userId)}&test=1`)
          .then(r => r.ok ? r.json() : Promise.reject())
          .then(games => {
            setCachedGames(games);
            document.getElementById('new-game').classList.toggle('fab-pulse', Array.isArray(games) && games.length === 0);
            if (cacheTimerFired) {
              renderGames(games);
            } else {
              pendingGames = games;
            }
          })
          .catch(() => {});
      } else {
        const fromGame = document.documentElement.classList.contains('vt-from-game');
        if (fromGame) {
          loadGames(true);
        } else {
          setTimeout(() => loadGames(), 500);
        }
      }
    }

    document.getElementById('topbar-user').addEventListener('click', e => {
      e.stopPropagation();
      document.getElementById('user-popover').classList.toggle('open');
    });
    document.addEventListener('click', () => {
      document.getElementById('user-popover').classList.remove('open');
    });
    let statsFetching = false;
    document.getElementById('stats-btn').addEventListener('click', async e => {
      e.stopPropagation();
      if (statsFetching) return;
      statsFetching = true;
      const iconEl = document.getElementById('stats-btn-icon');
      iconEl.innerHTML = '<div class="stats-spin"></div>';
      try {
        const statsRes = await fetch(`/api/stats?userId=${userId}`);
        const stats = await statsRes.json();
        const correct = stats.correct_answers || 0;
        const total = stats.total_questions || 0;
        const pct = total > 0 ? Math.round((correct / total) * 100) : 0;
        const gameCount = currentGames.length;
        if (gameCount === 0) {
          document.getElementById('stats-modal-header-text').textContent = 'You have no Stats';
          document.getElementById('stats-modal-subheading').textContent = 'No games yet';
        } else {
          document.getElementById('stats-modal-header-text').textContent = `Your Stats Over ${gameCount} Game${gameCount !== 1 ? 's' : ''}`;
          let leading = 0, tied = 0;
          for (const g of currentGames) {
            const mine = g.my_score || 0;
            const maxOther = Math.max(0, ...(g.players || []).map(p => p.score || 0));
            if (mine > 0 && mine > maxOther) leading++;
            else if (mine > 0 && mine === maxOther) tied++;
            else if (mine === 0 && maxOther === 0 && (g.players || []).length > 0) tied++;
          }
          let sub;
          if (gameCount === 1) {
            sub = leading === 1 ? "You're leading in your only game"
                : tied === 1    ? "You're tied in your only game"
                :                 "You're not leading in your only game";
          } else {
            const all = gameCount;
            if (leading === 0 && tied === 0) {
              sub = "Leading or tied in none";
            } else if (leading === all) {
              sub = `Leading in all ${all} Games`;
            } else if (tied === all) {
              sub = `Tied in all ${all} Games`;
            } else if (leading + tied === all) {
              sub = leading === 0 ? `Tied in ${all} Games`
                  : tied === 0    ? `Leading in ${all} Games`
                  : `Leading in ${leading} Games, Tied in ${tied}`;
            } else if (leading === 0) {
              sub = `Tied in ${tied} Game${tied !== 1 ? 's' : ''}`;
            } else if (tied === 0) {
              sub = `Leading in ${leading} Game${leading !== 1 ? 's' : ''}`;
            } else {
              sub = `Leading in ${leading} Games, Tied in ${tied}`;
            }
          }
          document.getElementById('stats-modal-subheading').textContent = sub;
        }
        const avatarEl = document.getElementById('stats-modal-avatar');
        avatarEl.innerHTML = currentUser?.avatar_url
          ? `<img class="player-avatar" src="${currentUser.avatar_url}" alt="${currentUser.display_name || ''}" />`
          : `<div class="player-avatar-placeholder">👤</div>`;
        document.getElementById('stats-modal-name').textContent = currentUser?.display_name || '';
        const coinEl = document.getElementById('stats-modal-coin');
        coinEl.textContent = Math.min(correct, 999);
        coinEl.classList.toggle('coin-3digit', correct > 99);
        coinEl.style.display = correct === 0 ? 'none' : '';
        document.getElementById('stats-modal-stat').textContent = gameCount === 0 ? 'Waiting' : `${correct} / ${total} (${pct}%)`;
        const streaksEl = document.getElementById('stats-modal-streaks');
        streaksEl.style.display = gameCount === 0 ? 'none' : '';
        const lg = stats.longest_game;
        let longestGameStr = '—';
        if (lg && lg.question_count > 0) {
          const days = lg.first_question_date
            ? Math.round((Date.now() - new Date(lg.first_question_date).getTime()) / 86400000)
            : null;
          longestGameStr = days !== null
            ? `${lg.question_count} Questions / ${days} Days`
            : `${lg.question_count} Questions`;
        }
        const weekTotal   = stats.total_questions_week || 0;
        const weekCorrect = stats.correct_answers_week || 0;
        const weekPct     = weekTotal > 0 ? Math.round((weekCorrect / weekTotal) * 100) : 0;
        const weekStr     = weekTotal > 0 ? `${weekCorrect} / ${weekTotal} (${weekPct}%)` : '—';
        streaksEl.innerHTML = [
          `<div class="stats-streak-row">Correct Streak: <strong>${stats.longest_streak_overall || 0}</strong></div>`,
          `<div class="stats-streak-row">Correct Streak in a Game: <strong>${stats.longest_streak_single_game || 0}</strong></div>`,
          `<div class="stats-streak-row">Longest Game: <strong>${longestGameStr}</strong></div>`,
          `<div class="stats-streak-row">Past Week: <strong>${weekStr}</strong></div>`,
        ].join('');
        document.getElementById('stats-modal-backdrop').classList.add('open');
      } catch {}
      iconEl.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>';
      document.getElementById('user-popover').classList.remove('open');
      statsFetching = false;
    });
    document.getElementById('stats-modal-backdrop').addEventListener('click', e => {
      if (e.target === document.getElementById('stats-modal-backdrop'))
        document.getElementById('stats-modal-backdrop').classList.remove('open');
    });
    document.getElementById('stats-modal-backdrop').addEventListener('touchmove', e => e.preventDefault(), { passive: false });
    (function() {
      const backdrop = document.getElementById('stats-modal-backdrop');
      const modal    = document.getElementById('stats-modal');
      let startY = 0, startTime = 0, currentY = 0, dragging = false;
      function closeModal(throwY) {
        modal.style.transition = 'opacity 0.22s ease, transform 0.22s ease';
        modal.style.transform  = `translateY(${throwY}px)`;
        modal.style.opacity    = '0';
        backdrop.style.transition = 'background 0.15s ease';
        setTimeout(() => {
          backdrop.classList.remove('open');
          backdrop.style.transition = '';
          modal.style.transition = '';
          modal.style.transform  = '';
          modal.style.opacity    = '';
        }, 220);
      }
      modal.addEventListener('touchstart', e => {
        startY    = e.touches[0].clientY;
        startTime = Date.now();
        currentY  = 0;
        dragging  = true;
        modal.style.transition = 'none';
      }, { passive: true });
      modal.addEventListener('touchmove', e => {
        if (!dragging) return;
        currentY = e.touches[0].clientY - startY;
        const resistance = currentY < 0 ? 0.35 : 0.45;
        modal.style.transform = `translateY(${currentY * resistance}px)`;
        modal.style.opacity   = String(Math.max(0, 1 - Math.abs(currentY) / 320));
      }, { passive: true });
      modal.addEventListener('touchend', () => {
        if (!dragging) return;
        dragging = false;
        const velocity = currentY / (Date.now() - startTime);
        const isFlick  = Math.abs(velocity) > 0.5;
        const isDrag   = Math.abs(currentY) > 120;
        if (isFlick || isDrag) {
          closeModal(currentY < 0 ? -220 : 220);
        } else {
          modal.style.transition = 'opacity 0.27s ease, transform 0.27s ease';
          modal.style.transform  = '';
          modal.style.opacity    = '';
        }
      });
    })();

    document.getElementById('logout-btn').addEventListener('click', () => {
      localStorage.removeItem('userId');
      navigator.serviceWorker.controller?.postMessage({ type: 'CLEAR_API_ME' });
      location.replace('/');
    });

    function openPanel() {
      document.body.classList.add('panel-open');
    }
    function closePanel() {
      document.querySelector('.content').scrollTop = 0;
      document.body.classList.remove('panel-open');
      document.getElementById('create-btn').disabled = true;
    }

    document.getElementById('new-game').addEventListener('click', () => {
      openPanel();
      document.getElementById('users-list-scroller').scrollTop = 0;
      loadUsers();
    });
    const closePanelBtn = document.getElementById('close-panel');
    closePanelBtn.addEventListener('touchend', e => {
      e.preventDefault();
      closePanel();
    });
    closePanelBtn.addEventListener('click', closePanel);

    function showErrorModal(msg) {
      document.getElementById('error-modal-msg').textContent = msg;
      document.getElementById('error-modal-backdrop').classList.add('open');
    }
    document.getElementById('error-modal-ok').addEventListener('click', () => {
      document.getElementById('error-modal-backdrop').classList.remove('open');
    });
    document.getElementById('error-modal-backdrop').addEventListener('touchmove', e => e.preventDefault(), { passive: false });

    function updateCreateBtn() {
      const anyChecked = document.querySelector('#users-list input:checked');
      const btn = document.getElementById('create-btn');
      btn.disabled = !anyChecked;
    }

    document.getElementById('create-btn').addEventListener('click', async () => {
      const checked = [...document.querySelectorAll('#users-list input:checked')];
      if (!checked.length) return;

      const friendIds = checked.map(cb => Number(cb.closest('.user-row').dataset.userId));
      const btn = document.getElementById('create-btn');
      const rows = [...document.querySelectorAll('#users-list .user-row')];

      function reEnableRows() {
        btn.style.width = '';
        btn.classList.remove('loading');
        btn.disabled = false;
        rows.forEach(row => {
          row.style.pointerEvents = '';
          row.querySelector('input').disabled = false;
        });
      }

      // Disable UI and show spinner in button (lock width first so it doesn't shrink)
      btn.style.width = btn.offsetWidth + 'px';
      btn.disabled = true;
      btn.classList.add('loading');

      rows.forEach(row => {
        row.style.pointerEvents = 'none';
        row.querySelector('input').disabled = true;
      });

      try {
        const res = await fetch('/api/games', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ userId, friendIds }),
        });

        if (res.ok) {
          await loadGames(true, true);
          closePanel();
          btn.style.width = '';
          btn.classList.remove('loading');
          btn.disabled = true;
        } else {
          const data = await res.json();
          reEnableRows();
          showErrorModal(res.status === 409 ? data.error : 'Sorry, something went wrong');
        }
      } catch (e) {
        reEnableRows();
        showErrorModal('Sorry, something went wrong');
      }
    });

    function escHtml(str) {
      return String(str ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }

    function setCachedGames(games) {
      try { localStorage.setItem(GAMES_CACHE_KEY, JSON.stringify({ games, savedAt: Date.now() })); } catch {}
    }

    function loadGames(silent = false, noFade = false) {
      const fab = document.getElementById('new-game');
      const spinner = document.getElementById('games-spinner');
      const gamesList = document.getElementById('games-list');
      if (!silent) spinner.classList.remove('hidden');
      const delay = silent ? Promise.resolve() : new Promise(res => setTimeout(res, 1000));
      const fetch$ = fetch(`/api/games?userId=${encodeURIComponent(userId)}&test=1`)
        .then(r => r.ok ? r.json() : Promise.reject());

      return Promise.all([fetch$, delay])
        .then(([games]) => {
          lastLoadedAt = Date.now();
          setCachedGames(games);
          if (!silent) {
            spinner.classList.add('hidden');
            setTimeout(() => { fab.style.opacity = '1'; }, 575);
          }
          fab.classList.toggle('fab-pulse', Array.isArray(games) && games.length === 0);
          if (silent && !noFade && gamesList.querySelector('.game-row-wrapper')) {
            gamesList.style.opacity = '0';
            setTimeout(() => { renderGames(games); gamesList.style.opacity = '1'; }, 360);
          } else if (!silent || noFade || (Array.isArray(games) && games.length > 0)) {
            gamesList.style.opacity = '';
            renderGames(games);
          }
        })
        .catch(() => {
          if (!silent) {
            spinner.classList.add('hidden');
            setTimeout(() => { fab.style.opacity = '1'; }, 575);
          }
        });
    }

    function buildViewResponsesHtml(players, myAnswer, relativeTo) {
      const esc = s => String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
      const sorted = [...players].sort((a, b) => (a._isMe ? 1 : 0) - (b._isMe ? 1 : 0));
      return sorted.slice(0, 5).map(p => {
        const rawName = (p.display_name || '').trim();
        const parts = rawName.split(' ');
        const fn = parts[0] || '';
        const initials = parts.length >= 2
          ? parts[0][0].toUpperCase() + parts[parts.length - 1][0].toUpperCase()
          : (parts[0] ? parts[0][0].toUpperCase() : '');
        const displayName = p._isMe ? 'You' : esc(fn.length <= 5 ? fn : initials);
        const avatarInner = p.avatar_url
          ? `<img class="player-avatar" src="${esc(p.avatar_url)}" alt="${displayName}" />`
          : `<div class="player-avatar-placeholder">👤</div>`;
        const unansweredIncorrect = !p._answered && !!relativeTo;
        const statusClass = unansweredIncorrect ? 'answered-wrong' : (!p._answered ? 'waiting' : p._isCorrect ? 'answered' : 'answered-wrong');
        const statusText = (relativeTo && p._answeredAt)
          ? relativeAnswerTime(relativeTo, false, p._answeredAt)
          : unansweredIncorrect
            ? relativeAnswerTime(relativeTo, true, null)
            : relativeAnswerTime(p._answeredAt, false, null, true);
        const answerText = p._isMe && myAnswer ? esc(myAnswer) : (p._answer ? esc(p._answer) : '');
        const incorrectBadge = `<div class="player-answered-badge incorrect"><svg width="7.5" height="7.5" viewBox="0 0 6 6" fill="none"><line x1="1.5" y1="1.5" x2="4.5" y2="4.5" stroke="#e53935" stroke-width="1.2" stroke-linecap="round"/><line x1="4.5" y1="1.5" x2="1.5" y2="4.5" stroke="#e53935" stroke-width="1.2" stroke-linecap="round"/></svg></div>`;
        let badge = '';
        if (p._answered && p._isCorrect) {
          badge = `<div class="player-answered-badge"><svg width="7.5" height="7.5" viewBox="0 0 6 6" fill="none"><polyline points="1,3 2.5,4.5 5,1.5" stroke="#43a047" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/></svg></div>`;
        } else if ((p._answered && p._isCorrect === false) || unansweredIncorrect) {
          badge = incorrectBadge;
        }
        const score = p.score || 0;
        const coinShimmer = p._isCorrect ? ' coin-shimmer' : '';
        const coinBadge = score > 0
          ? `<div class="coin player-score-coin${coinShimmer}${score > 99 ? ' coin-3digit' : ''}">${Math.min(score, 999)}</div>`
          : '';
        return `<div class="answer-response-row">
          <div class="ar-player">
            <div class="player-avatar-wrap">${avatarInner}${badge}${coinBadge}</div>
            <div class="game-player-info">
              <span class="player-name">${displayName}</span>
              <span class="player-status ${statusClass}">${statusText}</span>
            </div>
          </div>
          <div class="ar-answer">${answerText}</div>
        </div>`;
      }).join('');
    }

    let gameViewData = new Map();
    let gamePrevViewData = new Map();
    function renderGames(games) {
      currentGames = Array.isArray(games) ? games : [];
      const list = document.getElementById('games-list');
      if (!Array.isArray(games) || games.length === 0) {
        list.innerHTML = '<p class="games-empty">You aren\'t a member of any games</p><picture><source srcset="/images/fjwf_logo.webp" type="image/webp"><img src="/images/fjwf_logo_compressed.png" class="games-empty-logo" alt="Final Jeopardy logo"></picture>';
        prevGameIds = new Set();
        // Force a reflow to clear stale rendering in Mobile Safari
        list.style.display = 'none';
        list.offsetHeight; // eslint-disable-line no-unused-expressions
        list.style.display = '';
        return;
      }

      const MAX_VISIBLE = 3;
      const sortedGames = [...games].sort((a, b) => {
        const cqIdA = a.current_question ? a.current_question.game_question_id : null;
        const cqIdB = b.current_question ? b.current_question.game_question_id : null;
        const aAnswered = !!(currentUser && cqIdA && (a.answers || []).some(ans => ans.game_question_id === cqIdA && ans.user_id === currentUser.id));
        const bAnswered = !!(currentUser && cqIdB && (b.answers || []).some(ans => ans.game_question_id === cqIdB && ans.user_id === currentUser.id));
        if (aAnswered !== bAnswered) return aAnswered ? 1 : -1;
        const aTime = a.current_question ? new Date(a.current_question.asked_at || 0).getTime() : 0;
        const bTime = b.current_question ? new Date(b.current_question.asked_at || 0).getTime() : 0;
        return bTime - aTime;
      });
      const staggerMs = sortedGames.length > 1 ? Math.max(28, Math.round(70 / Math.sqrt(sortedGames.length - 1))) : 0;
      list.innerHTML = sortedGames.map((game, idx) => {
        const rawCategory = game.current_question ? game.current_question.category : 'No question yet';
        const category = toTitleCase(rawCategory);
        const cqId = game.current_question ? game.current_question.game_question_id : null;
        const cqAnswers = cqId ? (game.answers || []).filter(a => a.game_question_id === cqId) : [];
        const answerByUser = new Map(cqAnswers.map(a => [a.user_id, a]));
        const myAnswer = currentUser ? answerByUser.get(currentUser.id) : null;
        const iAnswered = !!myAnswer;

        const playerWithAnswer = p => {
          const ans = answerByUser.get(p.id);
          return { ...p, _answered: !!ans, _isCorrect: ans ? !!ans.is_correct : null, _answeredAt: ans ? ans.answered_at : null, _answer: ans ? ans.answer : null };
        };

        // Build combined player list: others first, current user last
        const others = game.players || [];
        const meEntry = currentUser ? { ...currentUser, _isMe: true, score: game.my_score || 0, _answered: iAnswered, _isCorrect: myAnswer ? !!myAnswer.is_correct : null, _answeredAt: myAnswer ? myAnswer.answered_at : null } : null;
        const combined = meEntry ? [...others.map(playerWithAnswer), meEntry] : others.map(playerWithAnswer);

        const overflow = combined.length > MAX_VISIBLE ? combined.length - MAX_VISIBLE : 0;
        const visible = overflow > 0 ? combined.slice(0, MAX_VISIBLE) : combined;

        const playerHtml = visible.map(p => buildPlayerCardHtml(p, { short: combined.length > 3, simpleCoin: true })).join('');

        const overflowHtml = overflow > 0
          ? `<div class="game-player"><div class="player-overflow-circle">+${overflow}</div></div>`
          : '';

        const pq = game.previous_question;
        const pqAnswerByUser = pq
          ? new Map((game.previous_answers || []).filter(a => a.game_question_id === pq.game_question_id).map(a => [a.user_id, a]))
          : null;
        const prevRowHtml = pq ? (() => {
          const pqCategory = toTitleCase(pq.category);
          const pqPlayers = combined.map(p => {
            const ans = pqAnswerByUser.get(p.id);
            return { ...p, _answered: !!ans, _isCorrect: ans ? !!ans.is_correct : null, _answeredAt: ans ? ans.answered_at : null, _answer: ans ? ans.answer : null };
          });
          const pqVisible = pqPlayers.length > MAX_VISIBLE ? pqPlayers.slice(0, MAX_VISIBLE) : pqPlayers;
          const pqOverflow = pqPlayers.length > MAX_VISIBLE ? pqPlayers.length - MAX_VISIBLE : 0;
          const pqPlayerHtml = pqVisible.map(p => buildPlayerCardHtml(p, { short: pqPlayers.length > 3, unansweredIncorrect: true, askedAt: pq.asked_at, relativeTo: pq.asked_at, simpleCoin: true })).join('');
          const pqOverflowHtml = pqOverflow > 0 ? `<div class="game-player"><div class="player-overflow-circle">+${pqOverflow}</div></div>` : '';
          const myPqAnswer = pqAnswerByUser.get(currentUser ? currentUser.id : null);
          gamePrevViewData.set(String(game.id), { players: pqPlayers, myAnswer: myPqAnswer ? myPqAnswer.answer : '', askedAt: pq.asked_at, relativeTo: pq.asked_at, category: pqCategory, question: pq.question, correctAnswer: pq.answer });
          return `<div class="game-row game-row-previous" data-game-id="${escHtml(game.id)}">
            <div class="game-row-header">
              <span class="game-category">${escHtml(pqCategory)}</span>
            </div>
            <div class="game-row-body">
              <div class="game-players" style="gap:${pqPlayers.length > 3 ? '2px' : '4px'}">${pqPlayerHtml}${pqOverflowHtml}</div>
              <button class="view-btn">Answers</button>
            </div>
            <div class="game-row-summary">${formatQuestionDate(pq.asked_at)}</div>
          </div>`;
        })() : '';

        const isExisting = prevGameIds !== null && prevGameIds.has(String(game.id));
        return `<div class="game-row-wrapper" data-game-id="${escHtml(game.id)}" style="${isExisting ? 'animation:none' : `animation-delay:${(idx * staggerMs / 1000).toFixed(3)}s`}">
          <div class="game-row-inner">
          ${prevRowHtml}
          <div class="game-row-delete-action">
            <button class="delete-game-btn" aria-label="Delete game">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="3 6 5 6 21 6"></polyline>
                <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
              </svg>
            </button>
          </div>
          <div class="game-row">
            <div class="game-row-header">
              <span class="game-category">${escHtml(category)}</span>
            </div>
            <div class="game-row-body">
              <div class="game-players" style="gap:${combined.length > 3 ? '2px' : '4px'}">${playerHtml}${overflowHtml}</div>
              ${iAnswered
                ? (() => { gameViewData.set(String(game.id), { players: combined, myAnswer: myAnswer ? myAnswer.answer : '', askedAt: game.current_question ? game.current_question.asked_at : '', category, question: game.current_question ? game.current_question.question : '', correctAnswer: game.current_question ? game.current_question.answer : '' }); return `<button class="view-btn">Answers</button>`; })()
                : `<button class="answer-btn" style="animation-delay: -${(idx * 0.3) % 1.4}s">Answer</button>`
              }
            </div>
            <div class="game-row-summary">${nextQuestionSummary(game.current_question ? game.current_question.asked_at : '', combined)}</div>
          </div>
          </div>
        </div>`;
      }).join('');

      if (prevGameIds !== null) {
        list.querySelectorAll('.game-row-wrapper').forEach(wrapper => {
          if (!prevGameIds.has(wrapper.dataset.gameId)) {
            wrapper.classList.add('new-row');
            const btn = wrapper.querySelector('.answer-btn');
            if (btn) {
              const originalDelay = btn.style.animationDelay;
              btn.style.animationDelay = '5600ms';
              setTimeout(() => { btn.style.animationDelay = originalDelay; }, 5600);
            }
          }
        });
      }
      prevGameIds = new Set(sortedGames.map(g => String(g.id)));

      // Prefetch /game?id=X for each game that still has an answer button
      document.querySelectorAll('link[rel="prefetch"][data-game-prefetch]').forEach(el => el.remove());
      list.querySelectorAll('.game-row-wrapper').forEach(wrapper => {
        if (wrapper.querySelector('.answer-btn')) {
          const link = document.createElement('link');
          link.rel = 'prefetch';
          link.href = `/game?id=${encodeURIComponent(wrapper.dataset.gameId)}`;
          link.dataset.gamePrefetch = '1';
          document.head.appendChild(link);
        }
      });



      function openPrevModal(gameId) {
        const { players, myAnswer, askedAt, relativeTo, category, question, correctAnswer } = gamePrevViewData.get(gameId) || {};
        document.getElementById('view-modal-category').textContent = toTitleCase(category || '');
        document.getElementById('view-modal-question').textContent = question || '';
        document.getElementById('view-modal-answer').textContent = toTitleCase(correctAnswer || '');
        document.getElementById('view-modal-content').innerHTML = buildViewResponsesHtml(players, myAnswer, relativeTo);
        document.getElementById('view-modal-footer').innerHTML = formatQuestionDate(askedAt);
        document.getElementById('view-modal').classList.remove('current-question');
        document.getElementById('view-modal-backdrop').classList.add('open');
      }

      document.querySelectorAll('.view-btn').forEach(btn => {
        btn.addEventListener('click', e => {
          e.stopPropagation();
          const wrapper = btn.closest('.game-row-wrapper');
          const gameId = wrapper.dataset.gameId;
          if (wrapper.dataset.revealed === 'true' && gamePrevViewData.has(gameId)) {
            openPrevModal(gameId);
            return;
          }
          const { players, myAnswer, askedAt, category, question, correctAnswer } = gameViewData.get(gameId) || {};
          document.getElementById('view-modal-category').textContent = toTitleCase(category || '');
          document.getElementById('view-modal-question').textContent = question || '';
          document.getElementById('view-modal-answer').textContent = toTitleCase(correctAnswer || '');
          document.getElementById('view-modal-content').innerHTML = buildViewResponsesHtml(players, myAnswer);
          document.getElementById('view-modal-footer').innerHTML = nextQuestionSummary(askedAt, players);
          document.getElementById('view-modal').classList.add('current-question');
          document.getElementById('view-modal-backdrop').classList.add('open');
        });
      });

      document.querySelectorAll('.game-row-previous').forEach(row => {
        row.addEventListener('click', () => openPrevModal(row.dataset.gameId));
      });

      // Swipe-right to reveal previous question row; swipe-left to reveal delete button
      const DELETE_WIDTH = 78;
      document.querySelectorAll('.game-row-wrapper').forEach(wrapper => {
        const prevRow     = wrapper.querySelector('.game-row-previous');
        const inner       = wrapper.querySelector('.game-row-inner');
        const mainRow     = wrapper.querySelector('.game-row:not(.game-row-previous)');
        const deleteAction = wrapper.querySelector('.game-row-delete-action');

        let startX = 0, startY = 0, dirLocked = null, active = false, isRevealed = false, deleteRevealed = false;

        const ease = 'transform 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94)';
        const setDeleteOpacity = show => {
          if (!deleteAction) return;
          deleteAction.style.transition = show
            ? 'none'
            : 'opacity 0s 300ms';
          deleteAction.style.opacity = show ? '1' : '0';
        };
        const setTx = (tx, animated) => {
          mainRow.style.transition = animated ? ease : 'none';
          if (prevRow) prevRow.style.transition = animated ? ease : 'none';
          mainRow.style.transform = tx ? `translateX(${tx}px)` : '';
          // prevRow only follows for positive (right-swipe) translations
          if (prevRow) prevRow.style.transform = (tx > 0) ? `translateX(${tx}px)` : '';
          if (animated) {
            mainRow.addEventListener('transitionend', () => {
              mainRow.style.transition = '';
              if (prevRow) prevRow.style.transition = '';
            }, { once: true });
          }
        };

        mainRow.addEventListener('click', () => {
          if (deleteRevealed) {
            deleteRevealed = false;
            setDeleteOpacity(false);
            setTx(0, true);
            return;
          }
          const btn = wrapper.querySelector('.answer-btn');
          if (btn) {
            btn.style.width = btn.offsetWidth + 'px';
            btn.innerHTML = '<span class="btn-spinner"></span>';
            btn.classList.add('loading');
            window.location.href = `/game?id=${wrapper.dataset.gameId}`;
          } else {
            const viewBtn = wrapper.querySelector('.view-btn');
            if (viewBtn && !viewBtn.classList.contains('loading')) viewBtn.click();
          }
        });

        inner.addEventListener('touchstart', e => {
          if (e.touches.length !== 1) return;
          startX = e.touches[0].clientX;
          startY = e.touches[0].clientY;
          dirLocked = null;
          active = true;
          mainRow.style.transition = 'none';
          if (prevRow) prevRow.style.transition = 'none';
        }, { passive: true });

        inner.addEventListener('touchmove', e => {
          if (!active || e.touches.length !== 1) return;
          const dx = e.touches[0].clientX - startX;
          const dy = e.touches[0].clientY - startY;

          if (!dirLocked) {
            if (Math.abs(dx) > 8 && Math.abs(dx) > Math.abs(dy)) {
              dirLocked = 'h';
              cardSwiping = true;
            } else if (Math.abs(dy) > 8) {
              dirLocked = 'v';
              active = false;
              return;
            } else {
              return;
            }
          }

          if (dirLocked !== 'h') return;
          e.preventDefault();

          const fw = mainRow.offsetWidth;
          if (isRevealed) {
            const tx = Math.max(0, Math.min(fw, fw + dx));
            mainRow.style.transform = tx ? `translateX(${tx}px)` : '';
            if (prevRow) prevRow.style.transform = tx ? `translateX(${tx}px)` : '';
          } else if (deleteRevealed) {
            const tx = Math.max(-DELETE_WIDTH, Math.min(0, -DELETE_WIDTH + dx));
            mainRow.style.transform = `translateX(${tx}px)`;
            setDeleteOpacity(tx < 0);
          } else {
            if (dx > 0 && prevRow) {
              const tx = Math.min(fw, dx);
              mainRow.style.transform = `translateX(${tx}px)`;
              prevRow.style.transform = `translateX(${tx}px)`;
              setDeleteOpacity(false);
            } else if (dx < 0) {
              const tx = Math.max(-DELETE_WIDTH, dx);
              mainRow.style.transform = `translateX(${tx}px)`;
              setDeleteOpacity(true);
            } else {
              mainRow.style.transform = '';
              if (prevRow) prevRow.style.transform = '';
              setDeleteOpacity(false);
            }
          }
        }, { passive: false });

        const onTouchEnd = e => {
          if (!active) return;
          active = false;
          cardSwiping = false;
          if (dirLocked !== 'h') return;
          const dx = e.changedTouches[0].clientX - startX;
          const fw = mainRow.offsetWidth;
          if (isRevealed) {
            if (dx < -40) { isRevealed = false; wrapper.dataset.revealed = 'false'; setTx(0, true); }
            else           { setTx(fw, true); }
          } else if (deleteRevealed) {
            if (dx > 40) { deleteRevealed = false; setDeleteOpacity(false); setTx(0, true); }
            else          { setDeleteOpacity(true); setTx(-DELETE_WIDTH, true); }
          } else {
            if (dx > 40 && prevRow) { isRevealed = true; wrapper.dataset.revealed = 'true'; setTx(fw, true); }
            else if (dx < -40)      { deleteRevealed = true; setDeleteOpacity(true); setTx(-DELETE_WIDTH, true); }
            else                    { setDeleteOpacity(false); setTx(0, true); }
          }
        };

        inner.addEventListener('touchend',   onTouchEnd, { passive: true });
        inner.addEventListener('touchcancel', () => {
          if (!active) return;
          active = false;
          cardSwiping = false;
          if (isRevealed) setTx(mainRow.offsetWidth, true);
          else if (deleteRevealed) { setDeleteOpacity(true); setTx(-DELETE_WIDTH, true); }
          else { setDeleteOpacity(false); setTx(0, true); }
        }, { passive: true });

        if (deleteAction) {
          deleteAction.addEventListener('click', () => {
            const backdrop = document.getElementById('delete-modal-backdrop');
            backdrop.dataset.gameId = wrapper.dataset.gameId;
            backdrop.classList.add('open');
          });
        }
      });
    }

    // View modal close handlers
    document.getElementById('view-modal-backdrop').addEventListener('click', e => {
      if (e.target === document.getElementById('view-modal-backdrop')) {
        document.getElementById('view-modal-backdrop').classList.remove('open');
      }
    });
    document.getElementById('view-modal-backdrop').addEventListener('touchmove', e => e.preventDefault(), { passive: false });

    // iOS-style flick gesture to dismiss modal
    (function() {
      const backdrop = document.getElementById('view-modal-backdrop');
      const modal    = document.getElementById('view-modal');
      let startY = 0, startTime = 0, currentY = 0, dragging = false;

      function closeModal(throwY) {
        modal.style.transition = 'opacity 0.22s ease, transform 0.22s ease';
        modal.style.transform  = `translateY(${throwY}px)`;
        modal.style.opacity    = '0';
        backdrop.style.transition = 'background 0.15s ease';
        setTimeout(() => {
          backdrop.classList.remove('open');
          backdrop.style.transition = '';
          modal.style.transition = '';
          modal.style.transform  = '';
          modal.style.opacity    = '';
        }, 220);
      }

      modal.addEventListener('touchstart', e => {
        startY    = e.touches[0].clientY;
        startTime = Date.now();
        currentY  = 0;
        dragging  = true;
        modal.style.transition = 'none';
      }, { passive: true });

      modal.addEventListener('touchmove', e => {
        if (!dragging) return;
        currentY = e.touches[0].clientY - startY;
        const resistance = currentY < 0 ? 0.35 : 0.45;
        modal.style.transform = `translateY(${currentY * resistance}px)`;
        modal.style.opacity   = String(Math.max(0, 1 - Math.abs(currentY) / 320));
      }, { passive: true });

      modal.addEventListener('touchend', () => {
        if (!dragging) return;
        dragging = false;
        const velocity = currentY / (Date.now() - startTime); // px/ms
        const isFlick  = Math.abs(velocity) > 0.5;
        const isDrag   = Math.abs(currentY) > 120;
        if (isFlick || isDrag) {
          const throwY = currentY < 0 ? -220 : 220;
          closeModal(throwY);
        } else {
          modal.style.transition = 'opacity 0.27s ease, transform 0.27s ease';
          modal.style.transform  = '';
          modal.style.opacity    = '';
        }
      });
    })();

    // Delete modal close handlers
    document.getElementById('delete-modal-backdrop').addEventListener('touchmove', e => e.preventDefault(), { passive: false });
    document.getElementById('delete-modal-cancel').addEventListener('click', () => {
      document.getElementById('delete-modal-backdrop').classList.remove('open');
    });
    document.getElementById('delete-modal-confirm').addEventListener('click', async () => {
      const backdrop = document.getElementById('delete-modal-backdrop');
      const gameId = backdrop.dataset.gameId;
      const confirmBtn = document.getElementById('delete-modal-confirm');
      const cancelBtn = document.getElementById('delete-modal-cancel');

      confirmBtn.classList.add('loading');
      confirmBtn.disabled = true;
      cancelBtn.disabled = true;

      let ok = false;
      try {
        const res = await fetch(`/api/games/${encodeURIComponent(gameId)}`, { method: 'DELETE' });
        ok = res.ok;
      } catch (e) {}

      if (!ok) {
        confirmBtn.classList.remove('loading');
        confirmBtn.disabled = false;
        cancelBtn.disabled = false;
        return;
      }

      await loadGames(true, true);

      backdrop.classList.remove('open');
      setTimeout(() => {
        confirmBtn.classList.remove('loading');
        confirmBtn.disabled = false;
        cancelBtn.disabled = false;
      }, 200);
    });

    let usersCache = null;
    let usersCacheAt = 0;

    function loadUsers(silent = false) {
      const spinner = document.getElementById('panel-spinner');
      const list = document.getElementById('users-list');
      const scroller = document.getElementById('users-list-scroller');
      if (!silent) {
        spinner.classList.remove('hidden');
        scroller.innerHTML = '';
      }

      const now = Date.now();
      const cached = usersCache && now - usersCacheAt < 60_000;
      const delay = cached ? Promise.resolve() : new Promise(res => setTimeout(res, 400));
      const fetchUsers = cached
        ? Promise.resolve(usersCache)
        : fetch(`/api/users?userId=${encodeURIComponent(userId)}`)
            .then(r => r.ok ? r.json() : Promise.reject())
            .then(data => { usersCache = data; usersCacheAt = Date.now(); return data; });
      if (cached && !silent) spinner.classList.add('hidden');

      return Promise.all([fetchUsers, delay])
        .then(([users]) => {
          if (!silent) spinner.classList.add('hidden');
          const isAdmin = userId === '1';
          const applyUsers = () => {
            const selected = new Set([...scroller.querySelectorAll('.user-row input:checked')]
              .map(cb => cb.closest('.user-row').dataset.userId));
            const userStaggerMs = (!cached && !silent && users.length > 1) ? Math.max(22, Math.round(55 / Math.sqrt(users.length - 1))) : 0;
            const trashIcon = `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>`;
            scroller.innerHTML = users.map((u, i) => {
              const rowHtml = `<div class="user-row" data-user-id="${u.id}"${isAdmin ? '' : ` onclick="this.querySelector('input').click()"`} style="animation-delay:${(i * userStaggerMs / 1000).toFixed(3)}s">
                ${u.avatar_url
                  ? `<img src="${u.avatar_url}" alt="${u.display_name}" />`
                  : `<div class="user-avatar-placeholder">👤</div>`}
                <span class="user-name">${u.display_name}</span>
                <input type="checkbox" onclick="event.stopPropagation()" onchange="updateCreateBtn()" />
              </div>`;
              if (!isAdmin) return rowHtml;
              return `<div class="user-row-wrapper" data-user-id="${u.id}">${rowHtml}<div class="user-row-delete-action"><button class="delete-user-btn" aria-label="Delete user">${trashIcon}</button></div></div>`;
            }).join('');
            scroller.querySelectorAll('.user-row').forEach(row => {
              if (selected.has(row.dataset.userId)) row.querySelector('input').checked = true;
            });
            updateCreateBtn();
            if (isAdmin) setupUserSwipe();
          };
          if (silent && scroller.querySelector('.user-row')) {
            scroller.style.opacity = '0';
            setTimeout(() => { applyUsers(); scroller.style.opacity = '1'; }, 360);
          } else {
            scroller.style.opacity = '';
            applyUsers();
          }
        })
        .catch(() => {
          if (!silent) spinner.classList.add('hidden');
          scroller.innerHTML = '<p style="padding:16px;color:#888;">Could not load users.</p>';
        });
    }

    function setupUserSwipe() {
      const scroller = document.getElementById('users-list-scroller');
      const USER_DELETE_WIDTH = 80;
      scroller.querySelectorAll('.user-row-wrapper').forEach(wrapper => {
        const row = wrapper.querySelector('.user-row');
        const deleteAction = wrapper.querySelector('.user-row-delete-action');
        let startX = 0, startY = 0, dirLocked = null, active = false, deleteRevealed = false;
        const ease = 'transform 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94)';
        const setDeleteOpacity = show => {
          deleteAction.style.transition = show ? 'none' : 'opacity 0s 300ms';
          deleteAction.style.opacity = show ? '1' : '0';
        };
        const setTx = (tx, animated) => {
          row.style.transition = animated ? ease : 'none';
          row.style.transform = tx ? `translateX(${tx}px)` : '';
          if (animated) row.addEventListener('transitionend', () => { row.style.transition = ''; }, { once: true });
        };

        row.addEventListener('click', () => {
          if (deleteRevealed) {
            deleteRevealed = false;
            setDeleteOpacity(false);
            setTx(0, true);
          } else {
            row.querySelector('input').click();
          }
        });

        wrapper.addEventListener('touchstart', e => {
          if (e.touches.length !== 1) return;
          row.style.animation = 'none'; // clear rowFadeIn fill before gesture so transform isn't overridden mid-move
          startX = e.touches[0].clientX;
          startY = e.touches[0].clientY;
          dirLocked = null;
          active = true;
          row.style.transition = 'none';
        }, { passive: true });

        wrapper.addEventListener('touchmove', e => {
          if (!active || e.touches.length !== 1) return;
          const dx = e.touches[0].clientX - startX;
          const dy = e.touches[0].clientY - startY;
          if (!dirLocked) {
            if (Math.abs(dx) > 8 && Math.abs(dx) > Math.abs(dy)) { dirLocked = 'h'; cardSwiping = true; }
            else if (Math.abs(dy) > 8) { dirLocked = 'v'; active = false; return; }
            else return;
          }
          if (dirLocked !== 'h') return;
          e.preventDefault();
          if (deleteRevealed) {
            const tx = Math.max(-USER_DELETE_WIDTH, Math.min(0, -USER_DELETE_WIDTH + dx));
            row.style.transform = `translateX(${tx}px)`;
            setDeleteOpacity(tx < 0);
          } else if (dx < 0) {
            const tx = Math.max(-USER_DELETE_WIDTH, dx);
            row.style.transform = `translateX(${tx}px)`;
            setDeleteOpacity(true);
          } else {
            row.style.transform = '';
            setDeleteOpacity(false);
          }
        }, { passive: false });

        const onTouchEnd = e => {
          if (!active) return;
          active = false;
          cardSwiping = false;
          if (dirLocked !== 'h') return;
          const dx = e.changedTouches[0].clientX - startX;
          if (deleteRevealed) {
            if (dx > 40) { deleteRevealed = false; setDeleteOpacity(false); setTx(0, true); }
            else { setDeleteOpacity(true); setTx(-USER_DELETE_WIDTH, true); }
          } else {
            if (dx < -40) { deleteRevealed = true; setDeleteOpacity(true); setTx(-USER_DELETE_WIDTH, true); }
            else { setDeleteOpacity(false); setTx(0, true); }
          }
        };
        wrapper.addEventListener('touchend', onTouchEnd, { passive: true });
        wrapper.addEventListener('touchcancel', () => {
          if (!active) return;
          active = false;
          cardSwiping = false;
          if (deleteRevealed) { setDeleteOpacity(true); setTx(-USER_DELETE_WIDTH, true); }
          else { setDeleteOpacity(false); setTx(0, true); }
        }, { passive: true });

        deleteAction.addEventListener('click', () => {
          const backdrop = document.getElementById('delete-user-modal-backdrop');
          backdrop.dataset.targetUserId = wrapper.dataset.userId;
          const firstName = row.querySelector('.user-name').textContent.trim().split(/\s+/)[0];
          document.getElementById('delete-user-modal-msg').textContent = `Are you sure you want to delete ${firstName}?`;
          backdrop.classList.add('open');
        });
      });
    }

    // Delete user modal handlers
    document.getElementById('delete-user-modal-backdrop').addEventListener('touchmove', e => e.preventDefault(), { passive: false });
    document.getElementById('delete-user-modal-cancel').addEventListener('click', () => {
      document.getElementById('delete-user-modal-backdrop').classList.remove('open');
    });
    document.getElementById('delete-user-modal-confirm').addEventListener('click', async () => {
      const backdrop = document.getElementById('delete-user-modal-backdrop');
      const targetUserId = backdrop.dataset.targetUserId;
      const confirmBtn = document.getElementById('delete-user-modal-confirm');
      const cancelBtn = document.getElementById('delete-user-modal-cancel');

      confirmBtn.classList.add('loading');
      confirmBtn.disabled = true;
      cancelBtn.disabled = true;

      let ok = false;
      try {
        const res = await fetch(`/api/users/${encodeURIComponent(targetUserId)}?requesterId=${encodeURIComponent(userId)}`, { method: 'DELETE' });
        ok = res.ok;
      } catch (e) {}

      if (!ok) {
        confirmBtn.classList.remove('loading');
        confirmBtn.disabled = false;
        cancelBtn.disabled = false;
        return;
      }

      backdrop.classList.remove('open');
      setTimeout(() => {
        confirmBtn.classList.remove('loading');
        confirmBtn.disabled = false;
        cancelBtn.disabled = false;
      }, 200);

      // Remove the row from the DOM
      const scroller = document.getElementById('users-list-scroller');
      const wrapper = scroller.querySelector(`.user-row-wrapper[data-user-id="${targetUserId}"]`);
      if (wrapper) wrapper.remove();
      updateCreateBtn();
    });

    // Pull-to-refresh + bottom overscroll (shared setup)
    function setupPTR(el, scroller, ptr, ptrSpinner, loadFn, spinnerEl) {
      const THRESHOLD = 125;
      const DEADZONE = 36;
      let startY = 0, mode = null, triggered = false, lastDy = 0;

      const snapBack = () => {
        if (el.style.transform) {
          el.style.transition = 'transform 0.26s cubic-bezier(0.25, 0.46, 0.45, 0.94)';
          el.style.transform = '';
          setTimeout(() => { el.style.transition = ''; }, 260);
        }
        scroller.style.overflowY = '';
      };

      el.addEventListener('touchstart', e => {
        if (e.touches.length !== 1) return;
        if (spinnerEl && !spinnerEl.classList.contains('hidden')) return;
        startY = e.touches[0].clientY;
        mode = null;
        triggered = false;
        lastDy = 0;
        el.style.transition = '';
      }, { passive: true });

      el.addEventListener('touchmove', e => {
        if (cardSwiping) return;
        const dy = e.touches[0].clientY - startY;

        if (mode === null) {
          if (dy > 3 && scroller.scrollTop <= 0) {
            mode = 'ptr';
            startY = e.touches[0].clientY;
            ptrSpinner.style.transform = 'rotate(0deg)';
            scroller.style.overflowY = 'hidden';
          } else if (dy < -3 && scroller.scrollTop >= scroller.scrollHeight - scroller.clientHeight - 1) {
            mode = 'push';
            startY = e.touches[0].clientY;
          } else {
            return;
          }
        }

        const d = e.touches[0].clientY - startY;
        if (mode === 'ptr') {
          e.preventDefault();
          if (d > 0) {
            const edy = Math.max(0, d - DEADZONE);
            lastDy = d;
            el.style.transform = `translateY(${edy * 0.44}px)`;
            const spinEdy = Math.max(0, edy - 18);
            ptrSpinner.style.transform = `rotate(${Math.min(spinEdy * 2.83, 360)}deg)`;
            triggered = d >= THRESHOLD;
          } else {
            triggered = false;
            el.style.transform = '';
          }
        } else if (mode === 'push') {
          e.preventDefault();
          el.style.transform = d < 0 ? `translateY(${d * 0.41}px)` : '';
        }
      }, { passive: false });

      el.addEventListener('touchend', () => {
        if (mode === null) return;
        const wasMode = mode;
        mode = null;
        if (wasMode !== 'ptr' || !triggered) {
          snapBack();
          return;
        }
        triggered = false;
        el.style.transition = 'transform 0.15s ease';
        el.style.transform = 'translateY(48px)';
        ptrSpinner.style.animationDelay = `${-(Math.min(Math.max(lastDy - 36, 0) * 2.83, 360) % 360) / 360 * 0.7}s`;
        ptrSpinner.style.transform = '';
        requestAnimationFrame(() => { ptrSpinner.classList.add('ptr-spinning'); });
        loadFn().finally(() => {
          setTimeout(() => {
            ptrSpinner.style.transform = getComputedStyle(ptrSpinner).transform;
            ptrSpinner.classList.remove('ptr-spinning');
            ptrSpinner.style.animationDelay = '';
            requestAnimationFrame(() => {
              setTimeout(() => { snapBack(); }, 275);
            });
          }, 640);
        });
      });
      el.addEventListener('touchcancel', () => { mode = null; snapBack(); });
    }

    setupPTR(
      document.getElementById('users-list-wrap'),
      document.getElementById('users-list-scroller'),
      document.getElementById('ptr-indicator'),
      document.getElementById('ptr-spinner'),
      () => { usersCache = null; return loadUsers(true); },
      document.getElementById('panel-spinner')
    );

    setupPTR(
      document.getElementById('content'),
      document.getElementById('content'),
      document.getElementById('games-ptr-indicator'),
      document.getElementById('games-ptr-spinner'),
      () => loadGames(true),
      document.getElementById('games-spinner')
    );

    document.addEventListener('visibilitychange', function() {
      if (document.visibilityState !== 'visible') return;
      if (Date.now() - lastLoadedAt < 45 * 60 * 1000) return;
      lastLoadedAt = Date.now();
      const gamesList = document.getElementById('games-list');
      const spinner = document.getElementById('games-spinner');
      gamesList.style.opacity = '0';
      gamesList.innerHTML = '';
      spinner.classList.remove('hidden');
      prevGameIds = null;
      loadGames();
    });

    window.addEventListener('pagehide', function(e) {
      if (e.persisted) {
        // Clear game rows before the bfcache snapshot is taken so that when the
        // page is restored the snapshot shows a clean spinner, not stale rows.
        document.getElementById('games-list').innerHTML = '';
        document.getElementById('games-spinner').classList.remove('hidden');
      }
    });

    window.addEventListener('pageshow', function(e) {
      if (e.persisted) {
        document.querySelectorAll('.answer-btn.loading').forEach(btn => {
          btn.classList.remove('loading');
          btn.style.width = '';
          btn.innerHTML = 'Answer';
        });
        // Belt-and-suspenders: pagehide should have already cleared this in the
        // snapshot, but if it didn't fire we clear it here so rows don't persist.
        document.getElementById('games-list').innerHTML = '';
        document.getElementById('games-spinner').classList.remove('hidden');
        prevGameIds = null;
        setTimeout(loadGames, 400);
      }
    });
  </script>
</body>
</html>
