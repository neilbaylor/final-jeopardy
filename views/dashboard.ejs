<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="default" />
  <meta name="apple-mobile-web-app-title" content="Final Jeopardy with Friends" />
  <meta name="theme-color" content="#ffffff" />
  <link rel="manifest" href="/manifest.json" />
  <link rel="apple-touch-icon" href="/images/home-screen-ios.png" />
  <title>Final Jeopardy with Friends</title>
  <script>
    // Must run before first paint so the class is set before CSS is applied.
    window.addEventListener('pagereveal', e => {
      if (e.viewTransition) document.documentElement.classList.add('vt-entry');
    });
  </script>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    html { background: #fff; }

    body {
      touch-action: manipulation;
      background: #fff;
      height: 100vh;
      height: 100dvh;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      font-family: 'Segoe UI', system-ui, sans-serif;
      color: #111;
    }

    .topbar {
      background: #07102e;
      display: flex;
      align-items: center;
      justify-content: flex-start;
      padding-top: calc(env(safe-area-inset-top, 0px) + 12px);
      padding-bottom: 8px;
      padding-left: calc(env(safe-area-inset-left, 0px) + 6px);
      padding-right: 14px;
      min-height: calc(env(safe-area-inset-top, 0px) + 56px);
      flex-shrink: 0;
      box-shadow: 0 2px 8px rgba(0,0,0,0.25);
      position: relative;
    }

    .topbar-header-img {
      position: absolute;
      left: 50%;
      bottom: 0;
      top: 0;
      transform: translate(-50%, -16px);
      width: 185px;
      opacity: 0.95;
      object-fit: contain;
      pointer-events: none;
    }

    .avatar {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      object-fit: cover;
      border: 2px solid rgba(255,255,255,0.2);
    }

    .avatar-placeholder {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      background: rgba(255,255,255,0.15);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.1rem;
    }

    .topbar-user {
      display: flex;
      align-items: center;
      gap: 10px;
      position: relative;
      cursor: pointer;
      -webkit-tap-highlight-color: transparent;
    }

    #user-popover {
      position: absolute;
      top: calc(100% + 5px);
      left: 0;
      background: #fff;
      border-radius: 10px;
      box-shadow: 0 4px 20px rgba(0,0,0,0.22);
      min-width: 120px;
      z-index: 100;
      overflow: hidden;
      opacity: 0;
      transform: translateY(-4px);
      pointer-events: none;
      transition: opacity 0.20005s ease, transform 0.20005s ease;
    }
    #user-popover.open {
      opacity: 1;
      transform: translateY(0);
      pointer-events: auto;
    }
    #logout-btn {
      display: flex;
      align-items: center;
      justify-content: space-between;
      width: 100%;
      padding: 9px 12px;
      border: none;
      background: none;
      font-family: 'Segoe UI', system-ui, sans-serif;
      font-size: 1rem;
      font-weight: 500;
      color: #111;
      cursor: pointer;
      -webkit-tap-highlight-color: transparent;
    }
    #logout-btn:active { background: #fdf0ef; }

    .topbar-greeting {
      font-size: 0.9rem;
      color: rgba(255,255,255,0.85);
      font-weight: 600;
    }

    .spinner {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      border: 2px solid rgba(255,255,255,0.15);
      border-top-color: rgba(255,255,255,0.55);
      animation: spin 0.7s linear infinite;
    }

    @keyframes spin {
      to { transform: rotate(360deg); }
    }

    .content {
      flex: 1;
      overflow-y: auto;
      padding: 20px 16px;
    }

    .fab {
      position: absolute;
      bottom: calc(env(safe-area-inset-bottom, 0px) + 24px);
      right: calc(env(safe-area-inset-right, 0px) + 20px);
      height: 48px;
      border-radius: 999px;
      background: rgba(255, 213, 0, 0.88);
      border: none;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      padding: 0 18px 0 14px;
      box-shadow: 0 4px 14px rgba(0,0,0,0.18);
      transition: transform 0.15s ease, opacity 0.15s ease;
      -webkit-tap-highlight-color: transparent;
      font-family: 'Segoe UI', system-ui, sans-serif;
      font-size: 0.9rem;
      font-weight: 600;
      color: #07102e;
    }

    .fab:active {
      transform: scale(0.93);
      opacity: 0.8;
    }

    .fab svg {
      width: 24px;
      height: 24px;
      stroke: #07102e;
      stroke-width: 2.5;
      stroke-linecap: round;
    }

    .topbar, .fab {
      opacity: 0;
      animation: fadeIn 0.25s ease forwards;
      animation-delay: 0.1s;
    }

    @keyframes fadeIn {
      to { opacity: 1; }
    }

    .fab { animation-delay: 0.18s; }

    /* MPA View Transition: login slides down, dashboard is revealed behind it */
    @view-transition { navigation: auto; }

    @keyframes slide-down {
      to { transform: translateY(100dvh); opacity: 0.7; }
    }

    ::view-transition-old(root) {
      animation: slide-down 0.45s ease-in-out both;
      z-index: 1; /* Must be above ::view-transition-new so the slide is visible */
    }
    ::view-transition-new(root) {
      animation: none;
    }

    /* When arriving via a view transition, skip the topbar/fab fade-in so the
       transition screenshot captures them at full opacity (no flicker). */
    :root.vt-entry .topbar,
    :root.vt-entry .fab {
      animation: none;
      opacity: 1;
    }

    /* New-game panel + parallax */
    #dashboard-root {
      display: contents;
      transition: transform 0.42s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.42s cubic-bezier(0.4, 0, 0.2, 1);
    }
    body.panel-open #dashboard-root {
      display: block;
      position: fixed;
      inset: 0;
      transform: translateY(-10%);
      opacity: 0.96;
    }
    #new-game-panel {
      position: fixed;
      inset: 0;
      background: #fff;
      color: #111;
      transform: translateY(100%);
      transition: transform 0.42s cubic-bezier(0.4, 0, 0.2, 1);
      z-index: 50;
      display: flex;
      flex-direction: column;
      padding: env(safe-area-inset-top, 0px) env(safe-area-inset-right, 0px)
               env(safe-area-inset-bottom, 0px) env(safe-area-inset-left, 0px);
    }
    body.panel-open #new-game-panel {
      transform: translateY(0);
    }
    /* Panel header */
    #panel-header {
      display: flex;
      align-items: center;
      background: #07102e;
      padding: 6px 6px 6px 0px;
      min-height: 48px;
      flex-shrink: 0;
      clip-path: inset(0 -20px -20px -20px);
      box-shadow: 0 4px 10px rgba(0,0,0,0.22);
    }
    #panel-title {
      font-size: 0.9rem;
      font-weight: 600;
      color: #fff;
      letter-spacing: 0.01em;
      flex: 1;
    }
    #create-btn {
      background: rgba(255,213,0,0.88);
      border: none;
      border-radius: 999px;
      padding: 0 21px;
      height: 34px;
      font-family: 'Segoe UI', system-ui, sans-serif;
      font-size: 0.85rem;
      font-weight: 700;
      color: #07102e;
      cursor: pointer;
      flex-shrink: 0;
      transition: opacity 0.3s ease, transform 0.3s ease;
      -webkit-tap-highlight-color: transparent;
    }
    #create-btn:disabled {
      opacity: 0.35;
      cursor: default;
      transform: scale(0.9);
    }
    #close-panel {
      background: none;
      border: none;
      cursor: pointer;
      padding: 10px 12px 10px 8px;
      -webkit-tap-highlight-color: transparent;
      flex-shrink: 0;
    }
    #close-panel svg {
      width: 28px;
      height: 28px;
      stroke: #fff;
      stroke-width: 2.5;
      stroke-linecap: round;
      stroke-linejoin: round;
      display: block;
    }

    /* Spinner inside panel */
    #panel-spinner {
      display: flex;
      justify-content: center;
      padding-top: 50px;
    }
    #panel-spinner.hidden { display: none; }
    .panel-spin {
      width: 48px;
      height: 48px;
      border: 4px solid rgba(7,16,46,0.15);
      border-top-color: #07102e;
      border-radius: 50%;
      animation: panelSpin 0.7s linear infinite;
    }
    @keyframes panelSpin {
      to { transform: rotate(360deg); }
    }

    /* Pull-to-refresh indicator */
    #ptr-indicator {
      display: flex;
      justify-content: center;
      align-items: center;
      height: 0;
      overflow: hidden;
      flex-shrink: 0;
    }
    #ptr-indicator.ptr-snap {
      transition: height 0.25s ease;
    }
    #ptr-spinner {
      width: 28px;
      height: 28px;
      border: 3px solid rgba(7,16,46,0.15);
      border-top-color: #07102e;
      border-radius: 50%;
      flex-shrink: 0;
      will-change: transform;
    }
    #ptr-spinner.ptr-spinning {
      animation: panelSpin 0.7s linear infinite;
    }

    /* Users list */
    #users-list {
      overflow-y: auto;
      flex: 1;
      padding: 4px 0 12px;
    }
    .user-row {
      display: flex;
      align-items: center;
      gap: 14px;
      padding: 8px 16px;
      border-bottom: 1px solid #f0f0f0;
      cursor: pointer;
      -webkit-tap-highlight-color: transparent;
      touch-action: manipulation;
    }
    .user-row:last-child { border-bottom: none; }
    .user-row:has(input:checked) { background: #fafbff; }
    .user-row input[type="checkbox"] {
      appearance: none;
      -webkit-appearance: none;
      width: 22px;
      height: 22px;
      border-radius: 50%;
      border: 2px solid #ccc;
      margin-left: auto;
      flex-shrink: 0;
      transition: border-color 0.15s, background 0.15s;
      cursor: pointer;
      touch-action: manipulation;
    }
    .user-row input[type="checkbox"]:checked {
      border-color: #07102e;
      background: #07102e;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 10 8' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M1 4l3 3 5-6' stroke='%23fff' stroke-width='1.8' fill='none' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E");
      background-repeat: no-repeat;
      background-position: center;
      background-size: 12px 10px;
    }
    .user-row img, .user-row .user-avatar-placeholder {
      width: 42px;
      height: 42px;
      border-radius: 50%;
      object-fit: cover;
      flex-shrink: 0;
    }
    .user-avatar-placeholder {
      background: #e8eaf0;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.3rem;
    }
    .user-name {
      font-size: 1rem;
      font-weight: 500;
      color: #111;
      min-width: 0;
      flex: 1;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

</style>
</head>
<body>
  <div id="dashboard-root">
    <div class="topbar">
      <img class="topbar-header-img" src="data:image/jpeg;base64," alt="" />
      <div class="topbar-user" id="topbar-user">
        <div id="avatar-wrap"><div class="spinner"></div></div>
        <span id="topbar-greeting" class="topbar-greeting" style="display:none"></span>
        <div id="user-popover">
          <button id="logout-btn">Logout<svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg></button>
        </div>
      </div>
    </div>

    <div class="content" id="content"></div>

    <button class="fab" id="new-game" aria-label="New game">
      <svg viewBox="0 0 24 24" fill="none"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
      New Game
    </button>
  </div>

  <div id="new-game-panel">
    <div id="panel-header">
      <button id="close-panel" aria-label="Back">
        <svg viewBox="0 0 24 24" fill="none"><polyline points="15 18 9 12 15 6"/></svg>
      </button>
      <span id="panel-title">Select Friends For a Game</span>
      <button id="create-btn" disabled>Create</button>
    </div>
    <div id="panel-spinner"><div class="panel-spin"></div></div>
    <div id="ptr-indicator"><div id="ptr-spinner"></div></div>
    <div id="users-list"></div>
  </div>

  <script>
    document.addEventListener('touchmove', (e) => { if (e.touches.length > 1) e.preventDefault(); }, { passive: false });
    const userId = localStorage.getItem('userId');
    if (!userId) {
      location.replace('/');
    } else {
      fetch(`/api/me?userId=${encodeURIComponent(userId)}`)
        .then(r => r.ok ? r.json() : Promise.reject())
        .then(user => {
          const wrap = document.getElementById('avatar-wrap');
          wrap.innerHTML = user.avatar_url
            ? `<img class="avatar" src="${user.avatar_url}" alt="${user.display_name}" />`
            : `<div class="avatar-placeholder">👤</div>`;
          const parts = user.display_name ? user.display_name.trim().split(' ') : [];
          const firstName = parts[0] || '';
          const initials = parts.length >= 2 ? parts[0][0].toUpperCase() + parts[parts.length - 1][0].toUpperCase() : (parts[0] ? parts[0][0].toUpperCase() : '');
          if (firstName) {
            const greeting = document.getElementById('topbar-greeting');
            const label = firstName.length <= 8 ? firstName : initials;
            greeting.textContent = `Hi, ${label}!`;
            greeting.style.display = '';
          }
        })
        .catch(() => location.replace('/'));
    }

    document.getElementById('topbar-user').addEventListener('click', e => {
      e.stopPropagation();
      document.getElementById('user-popover').classList.toggle('open');
    });
    document.addEventListener('click', () => {
      document.getElementById('user-popover').classList.remove('open');
    });
    document.getElementById('logout-btn').addEventListener('click', () => {
      localStorage.removeItem('userId');
      location.replace('/');
    });

    document.getElementById('new-game').addEventListener('click', () => {
      document.body.classList.add('panel-open');
      loadUsers();
    });
    document.getElementById('close-panel').addEventListener('click', () => {
      document.body.classList.remove('panel-open');
      document.getElementById('create-btn').disabled = true;
    });

    function updateCreateBtn() {
      const anyChecked = document.querySelector('#users-list input:checked');
      document.getElementById('create-btn').disabled = !anyChecked;
    }

    let usersCache = null;
    let usersCacheAt = 0;

    function loadUsers(silent = false) {
      const spinner = document.getElementById('panel-spinner');
      const list = document.getElementById('users-list');
      if (!silent) spinner.classList.remove('hidden');
      list.innerHTML = '';

      const now = Date.now();
      const cached = usersCache && now - usersCacheAt < 60_000;
      const delay = cached ? Promise.resolve() : new Promise(res => setTimeout(res, 400));
      const fetchUsers = cached
        ? Promise.resolve(usersCache)
        : fetch(`/api/users?userId=${encodeURIComponent(userId)}`)
            .then(r => r.ok ? r.json() : Promise.reject())
            .then(data => { usersCache = data; usersCacheAt = Date.now(); return data; });
      if (cached && !silent) spinner.classList.add('hidden');

      return Promise.all([fetchUsers, delay])
        .then(([users]) => {
          if (!silent) spinner.classList.add('hidden');
          list.innerHTML = users.map(u => `
            <div class="user-row" onclick="this.querySelector('input').click()">
              ${u.avatar_url
                ? `<img src="${u.avatar_url}" alt="${u.display_name}" />`
                : `<div class="user-avatar-placeholder">👤</div>`}
              <span class="user-name">${u.display_name}</span>
              <input type="checkbox" onclick="event.stopPropagation()" onchange="updateCreateBtn()" />
            </div>
          `).join('');
        })
        .catch(() => {
          if (!silent) spinner.classList.add('hidden');
          list.innerHTML = '<p style="padding:16px;color:#888;">Could not load users.</p>';
        });
    }

    // Pull-to-refresh on #users-list
    (function() {
      const list = document.getElementById('users-list');
      const ptr = document.getElementById('ptr-indicator');
      const ptrSpinner = document.getElementById('ptr-spinner');
      const THRESHOLD = 64;
      let startY = 0, pulling = false, triggered = false;

      list.addEventListener('touchstart', e => {
        if (list.scrollTop === 0 && e.touches.length === 1) {
          startY = e.touches[0].clientY;
          pulling = true;
          triggered = false;
          ptr.classList.remove('ptr-snap');
        }
      }, { passive: true });

      list.addEventListener('touchmove', e => {
        if (!pulling) return;
        const dy = e.touches[0].clientY - startY;
        if (dy <= 0) { pulling = false; return; }
        e.preventDefault();
        const capped = Math.min(dy * 0.45, 56);
        ptr.style.height = capped + 'px';
        ptrSpinner.style.opacity = String(Math.min(dy / THRESHOLD, 1));
        ptrSpinner.style.transform = `rotate(${dy * 2}deg)`;
        triggered = dy >= THRESHOLD;
      }, { passive: false });

      list.addEventListener('touchend', () => {
        if (!pulling) return;
        pulling = false;
        ptr.classList.add('ptr-snap');
        if (triggered) {
          ptr.style.height = '48px';
          ptrSpinner.style.opacity = '1';
          ptrSpinner.style.transform = '';
          requestAnimationFrame(() => {
            ptrSpinner.classList.add('ptr-spinning');
          });
          usersCache = null;
          loadUsers(true).finally(() => {
            ptr.style.height = '0';
            ptrSpinner.classList.remove('ptr-spinning');
          });
        } else {
          ptr.style.height = '0';
        }
      });
    })();
  </script>
</body>
</html>
