<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="theme-color" content="#07102e" />
  <link rel="manifest" href="/manifest.json" />
  <title>Final Jeopardy! With Friends</title>
  <script>
    // Must run before first paint so the class is set before CSS is applied.
    window.addEventListener('pagereveal', e => {
      if (e.viewTransition) document.documentElement.classList.add('vt-entry');
    });
  </script>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      touch-action: manipulation;
      background: #fff;
      height: 100vh;
      height: 100dvh;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      font-family: 'Segoe UI', system-ui, sans-serif;
      color: #111;
    }

    .topbar {
      background: #07102e;
      display: flex;
      align-items: center;
      justify-content: flex-start;
      padding-top: calc(env(safe-area-inset-top, 0px) + 12px);
      padding-bottom: 8px;
      padding-left: calc(env(safe-area-inset-left, 0px) + 14px);
      padding-right: 14px;
      min-height: calc(env(safe-area-inset-top, 0px) + 56px);
      flex-shrink: 0;
      box-shadow: 0 2px 8px rgba(0,0,0,0.25);
    }

    .avatar {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      object-fit: cover;
      border: 2px solid rgba(255,255,255,0.2);
    }

    .avatar-placeholder {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      background: rgba(255,255,255,0.15);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.1rem;
    }

    .topbar-user {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .topbar-greeting {
      font-size: 0.9rem;
      color: rgba(255,255,255,0.85);
      font-weight: 400;
    }

    .spinner {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      border: 2px solid rgba(255,255,255,0.15);
      border-top-color: rgba(255,255,255,0.55);
      animation: spin 0.7s linear infinite;
    }

    @keyframes spin {
      to { transform: rotate(360deg); }
    }

    .content {
      flex: 1;
      overflow-y: auto;
      padding: 20px 16px;
    }

    .fab {
      position: fixed;
      bottom: calc(env(safe-area-inset-bottom, 0px) + 24px);
      right: calc(env(safe-area-inset-right, 0px) + 20px);
      height: 48px;
      border-radius: 999px;
      background: rgba(255, 213, 0, 0.88);
      border: none;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      padding: 0 18px 0 14px;
      box-shadow: 0 4px 14px rgba(0,0,0,0.18);
      transition: transform 0.15s ease, opacity 0.15s ease;
      -webkit-tap-highlight-color: transparent;
      font-family: 'Segoe UI', system-ui, sans-serif;
      font-size: 0.9rem;
      font-weight: 600;
      color: #07102e;
    }

    .fab:active {
      transform: scale(0.93);
      opacity: 0.8;
    }

    .fab svg {
      width: 24px;
      height: 24px;
      stroke: #07102e;
      stroke-width: 2.5;
      stroke-linecap: round;
    }

    .topbar, .fab {
      opacity: 0;
      animation: fadeIn 0.25s ease forwards;
      animation-delay: 0.1s;
    }

    @keyframes fadeIn {
      to { opacity: 1; }
    }

    .fab { animation-delay: 0.18s; }

    /* MPA View Transition: login slides down, dashboard is revealed behind it */
    @view-transition { navigation: auto; }

    @keyframes slide-down {
      to { transform: translateY(100dvh); opacity: 0.7; }
    }

    ::view-transition-old(root) {
      animation: slide-down 0.45s ease-in-out both;
      z-index: 1; /* Must be above ::view-transition-new so the slide is visible */
    }
    ::view-transition-new(root) {
      animation: none;
    }

    /* When arriving via a view transition, skip the topbar/fab fade-in so the
       transition screenshot captures them at full opacity (no flicker). */
    :root.vt-entry .topbar,
    :root.vt-entry .fab {
      animation: none;
      opacity: 1;
    }

    /* New-game panel + parallax */
    #dashboard-root {
      display: contents;
      transition: transform 0.42s cubic-bezier(0.4, 0, 0.2, 1);
    }
    body.panel-open #dashboard-root {
      display: block;
      position: fixed;
      inset: 0;
      transform: translateX(-25%);
    }
    #new-game-panel {
      position: fixed;
      inset: 0;
      background: #fff;
      color: #111;
      transform: translateX(100%);
      transition: transform 0.42s cubic-bezier(0.4, 0, 0.2, 1);
      z-index: 50;
      display: flex;
      flex-direction: column;
      padding: env(safe-area-inset-top, 0px) env(safe-area-inset-right, 0px)
               env(safe-area-inset-bottom, 0px) env(safe-area-inset-left, 0px);
    }
    body.panel-open #new-game-panel {
      transform: translateX(0);
    }
    /* Panel header */
    #panel-header {
      display: flex;
      align-items: center;
      background: #07102e;
      padding: 6px 14px 6px 4px;
      min-height: 48px;
      flex-shrink: 0;
      box-shadow: 0 2px 8px rgba(0,0,0,0.25);
    }
    #panel-title {
      font-size: 0.9rem;
      font-weight: 700;
      color: #fff;
      letter-spacing: 0.01em;
      flex: 1;
    }
    #create-btn {
      background: rgba(255,213,0,0.88);
      border: none;
      border-radius: 999px;
      padding: 0 16px;
      height: 34px;
      font-family: 'Segoe UI', system-ui, sans-serif;
      font-size: 0.85rem;
      font-weight: 700;
      color: #07102e;
      cursor: pointer;
      flex-shrink: 0;
      transition: opacity 0.15s;
      -webkit-tap-highlight-color: transparent;
    }
    #create-btn:disabled {
      opacity: 0.35;
      cursor: default;
    }
    #close-panel {
      background: none;
      border: none;
      cursor: pointer;
      padding: 10px 12px 10px 16px;
      -webkit-tap-highlight-color: transparent;
      flex-shrink: 0;
    }
    #close-panel svg {
      width: 28px;
      height: 28px;
      stroke: #fff;
      stroke-width: 2.5;
      stroke-linecap: round;
      stroke-linejoin: round;
      display: block;
    }

    /* Spinner inside panel */
    #panel-spinner {
      display: flex;
      justify-content: center;
      padding-top: 50px;
    }
    #panel-spinner.hidden { display: none; }
    .panel-spin {
      width: 48px;
      height: 48px;
      border: 4px solid rgba(7,16,46,0.15);
      border-top-color: #07102e;
      border-radius: 50%;
      animation: panelSpin 0.7s linear infinite;
    }
    @keyframes panelSpin {
      to { transform: rotate(360deg); }
    }

    /* Users list */
    #users-list {
      overflow-y: auto;
      flex: 1;
      padding: 4px 0 12px;
    }
    .user-row {
      display: flex;
      align-items: center;
      gap: 14px;
      padding: 9px 16px;
      border-bottom: 1px solid #f0f0f0;
      cursor: pointer;
      -webkit-tap-highlight-color: transparent;
    }
    .user-row:last-child { border-bottom: none; }
    .user-row:has(input:checked) { background: #f0f5ff; }
    .user-row input[type="checkbox"] {
      appearance: none;
      -webkit-appearance: none;
      width: 22px;
      height: 22px;
      border-radius: 50%;
      border: 2px solid #ccc;
      margin-left: auto;
      flex-shrink: 0;
      transition: border-color 0.15s, background 0.15s;
      cursor: pointer;
    }
    .user-row input[type="checkbox"]:checked {
      border-color: #07102e;
      background: #07102e;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 10 8' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M1 4l3 3 5-6' stroke='%23fff' stroke-width='1.8' fill='none' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E");
      background-repeat: no-repeat;
      background-position: center;
      background-size: 12px 10px;
    }
    .user-row img, .user-row .user-avatar-placeholder {
      width: 44px;
      height: 44px;
      border-radius: 50%;
      object-fit: cover;
      flex-shrink: 0;
    }
    .user-avatar-placeholder {
      background: #e8eaf0;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.3rem;
    }
    .user-name {
      font-size: 1rem;
      font-weight: 500;
      color: #111;
    }
  </style>
</head>
<body>
  <div id="dashboard-root">
    <div class="topbar">
      <div class="topbar-user">
        <div id="avatar-wrap"><div class="spinner"></div></div>
        <span id="topbar-greeting" class="topbar-greeting" style="display:none"></span>
      </div>
    </div>

    <div class="content" id="content"></div>

    <button class="fab" id="new-game" aria-label="New game">
      <svg viewBox="0 0 24 24" fill="none"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
      New Game
    </button>
  </div>

  <div id="new-game-panel">
    <div id="panel-header">
      <button id="close-panel" aria-label="Back">
        <svg viewBox="0 0 24 24" fill="none"><polyline points="15 18 9 12 15 6"/></svg>
      </button>
      <span id="panel-title">Select Friends For a Game</span>
      <button id="create-btn" disabled>Create</button>
    </div>
    <div id="panel-spinner"><div class="panel-spin"></div></div>
    <div id="users-list"></div>
  </div>

  <script>
    document.addEventListener('touchmove', (e) => { if (e.touches.length > 1) e.preventDefault(); }, { passive: false });
    const userId = localStorage.getItem('userId');
    if (!userId) {
      location.replace('/');
    } else {
      fetch(`/api/me?userId=${encodeURIComponent(userId)}`)
        .then(r => r.ok ? r.json() : Promise.reject())
        .then(user => {
          const wrap = document.getElementById('avatar-wrap');
          wrap.innerHTML = user.avatar_url
            ? `<img class="avatar" src="${user.avatar_url}" alt="${user.display_name}" />`
            : `<div class="avatar-placeholder">👤</div>`;
          const firstName = user.display_name ? user.display_name.trim().split(' ')[0] : '';
          if (firstName) {
            const greeting = document.getElementById('topbar-greeting');
            greeting.textContent = `Hi, ${firstName}!`;
            greeting.style.display = '';
          }
        })
        .catch(() => location.replace('/'));
    }

    document.getElementById('new-game').addEventListener('click', () => {
      document.body.classList.add('panel-open');
      loadUsers();
    });
    document.getElementById('close-panel').addEventListener('click', () => {
      document.body.classList.remove('panel-open');
      document.getElementById('create-btn').disabled = true;
    });

    function updateCreateBtn() {
      const anyChecked = document.querySelector('#users-list input:checked');
      document.getElementById('create-btn').disabled = !anyChecked;
    }

    let usersCache = null;
    let usersCacheAt = 0;

    function loadUsers() {
      const spinner = document.getElementById('panel-spinner');
      const list = document.getElementById('users-list');
      spinner.classList.remove('hidden');
      list.innerHTML = '';

      const now = Date.now();
      const cached = usersCache && now - usersCacheAt < 60_000;
      const delay = cached ? Promise.resolve() : new Promise(res => setTimeout(res, 400));
      const fetchUsers = cached
        ? Promise.resolve(usersCache)
        : fetch(`/api/users?userId=${encodeURIComponent(userId)}`)
            .then(r => r.ok ? r.json() : Promise.reject())
            .then(data => { usersCache = data; usersCacheAt = Date.now(); return data; });
      if (cached) spinner.classList.add('hidden');

      Promise.all([fetchUsers, delay])
        .then(([users]) => {
          spinner.classList.add('hidden');
          list.innerHTML = users.map(u => `
            <div class="user-row" onclick="this.querySelector('input').click()">
              ${u.avatar_url
                ? `<img src="${u.avatar_url}" alt="${u.display_name}" />`
                : `<div class="user-avatar-placeholder">👤</div>`}
              <span class="user-name">${u.display_name}</span>
              <input type="checkbox" onclick="event.stopPropagation()" onchange="updateCreateBtn()" />
            </div>
          `).join('');
        })
        .catch(() => {
          spinner.classList.add('hidden');
          list.innerHTML = '<p style="padding:16px;color:#888;">Could not load users.</p>';
        });
    }
  </script>
</body>
</html>
