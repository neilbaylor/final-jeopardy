<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="default" />
  <meta name="apple-mobile-web-app-title" content="Final Jeopardy" />
  <meta name="theme-color" content="#ffffff" />
  <link rel="manifest" href="/manifest.json" />
  <link rel="icon" type="image/x-icon" href="/images/favicon.ico" />
  <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32x32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/images/favicon-16x16.png" />
  <link rel="apple-touch-icon" href="/images/hone-screen-new.png" />
  <title>Final Jeopardy with Friends</title>
  <script>
    // Must run before first paint so the class is set before CSS is applied.
    window.addEventListener('pagereveal', e => {
      if (e.viewTransition) document.documentElement.classList.add('vt-entry');
    });
  </script>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    html { background: #07102e; overflow: hidden; }

    body {
      touch-action: manipulation;
      background: #fff;
      height: 100vh;
      height: 100dvh;
      overflow: hidden;
      position: relative;
      display: flex;
      flex-direction: column;
      font-family: 'Segoe UI', system-ui, sans-serif;
      color: #333;
    }
    #dashboard-root {
      position: relative;
      flex: 1;
      display: flex;
      flex-direction: column;
      will-change: transform;
      transition: transform 0.42s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.42s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .topbar {
      background: #07102e;
      display: flex;
      align-items: center;
      justify-content: flex-start;
      padding-top: calc(env(safe-area-inset-top, 0px) + 12px);
      padding-bottom: 8px;
      padding-left: calc(env(safe-area-inset-left, 0px) + 6px);
      padding-right: 14px;
      height: calc(env(safe-area-inset-top, 0px) + 60px);
      min-height: calc(env(safe-area-inset-top, 0px) + 60px);
      flex-shrink: 0;
      box-shadow: 0 4px 10px rgba(0,0,0,0.23);
      position: relative;
      z-index: 1;
    }

    .topbar-header-img {
      position: absolute;
      left: 50%;
      bottom: 0;
      top: 0;
      transform: translate(-50%, -16px);
      width: 185px;
      opacity: 0.95;
      object-fit: contain;
      pointer-events: none;
      z-index: 1;
    }

    .avatar {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      object-fit: cover;
      border: 2px solid rgba(255,255,255,0.2);
    }

    .avatar-placeholder {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      background: rgba(255,255,255,0.15);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.1rem;
    }

    .topbar-user {
      display: flex;
      align-items: center;
      gap: 10px;
      position: relative;
      cursor: pointer;
      -webkit-tap-highlight-color: transparent;
    }

    #user-popover {
      position: absolute;
      top: calc(100% + 5px);
      left: 0;
      background: #fff;
      border-radius: 10px;
      box-shadow: 0 4px 20px rgba(0,0,0,0.22);
      min-width: 120px;
      z-index: 100;
      overflow: hidden;
      opacity: 0;
      transform: translateY(-4px);
      pointer-events: none;
      transition: opacity 0.20005s ease, transform 0.20005s ease;
    }
    #user-popover.open {
      opacity: 1;
      transform: translateY(0);
      pointer-events: auto;
    }
    #logout-btn {
      display: flex;
      align-items: center;
      justify-content: space-between;
      width: 100%;
      padding: 9px 12px;
      border: none;
      background: none;
      font-family: 'Segoe UI', system-ui, sans-serif;
      font-size: 1rem;
      font-weight: 500;
      color: #333;
      cursor: pointer;
      -webkit-tap-highlight-color: transparent;
    }
    #logout-btn:active { background: #fdf0ef; }

    .topbar-greeting {
      font-size: 0.9rem;
      color: rgba(255,255,255,0.9);
      font-weight: 600;
    }

    .spinner {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      border: 2px solid rgba(255,255,255,0.15);
      border-top-color: rgba(255,255,255,0.55);
      animation: spin 0.7s linear infinite;
    }

    @keyframes spin {
      to { transform: rotate(360deg); }
    }

    .content {
      flex: 1;
      overflow-y: auto;
      overflow-x: clip;
      overscroll-behavior-y: contain;
      padding: 0 12px;
    }

    .fab {
      position: absolute;
      bottom: calc(env(safe-area-inset-bottom, 0px) + 24px);
      right: calc(env(safe-area-inset-right, 0px) + 20px);
      height: 48px;
      border-radius: 999px;
      background: rgba(255, 213, 0, 0.88);
      border: none;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      padding: 0 18px 0 14px;
      box-shadow: 0 4px 14px rgba(0,0,0,0.18);
      opacity: 0;
      transition: transform 0.15s ease, opacity 0.3s ease;
      -webkit-tap-highlight-color: transparent;
      font-family: 'Segoe UI', system-ui, sans-serif;
      font-size: 1rem;
      font-weight: 600;
      color: #07102e;
    }

    .fab:active {
      transform: scale(0.93);
      opacity: 0.8;
    }
    @keyframes fabPulse {
      0%   { box-shadow: 0 4px 14px rgba(0,0,0,0.18), 0 0 0 0 rgba(255,213,0,0.45); }
      100% { box-shadow: 0 4px 14px rgba(0,0,0,0.18), 0 0 0 12px rgba(255,213,0,0); }
    }
    .fab.fab-pulse {
      animation: fabPulse 1.4s ease-out infinite;
      will-change: box-shadow;
    }

    .fab svg {
      width: 24px;
      height: 24px;
      stroke: #07102e;
      stroke-width: 2.5;
      stroke-linecap: round;
    }

    .topbar {
      opacity: 0;
      animation: fadeIn 0.25s ease forwards;
      animation-delay: 0.1s;
    }

    @keyframes fadeIn {
      to { opacity: 1; }
    }

    /* MPA View Transition: login slides down, dashboard is revealed behind it */
    @view-transition { navigation: auto; }

    @keyframes slide-down {
      to { transform: translateY(100dvh); opacity: 0.85; }
    }

    ::view-transition-old(root) {
      animation: slide-down 0.45s ease-in-out both;
      z-index: 1; /* Must be above ::view-transition-new so the slide is visible */
    }
    ::view-transition-new(root) {
      animation: none;
    }

    /* When arriving via a view transition, skip the topbar/fab fade-in so the
       transition screenshot captures them at full opacity (no flicker). */
    :root.vt-entry .topbar {
      animation: none;
      opacity: 1;
    }

    /* New-game panel + parallax */
    body.panel-open #dashboard-root {
      transform: translateY(-10%);
      opacity: 0.96;
    }
    #new-game-panel {
      position: absolute;
      inset: 0;
      background: #f9f9f9;
      color: #333;
      transform: translateY(100%);
      visibility: hidden;
      transition: transform 0.42s cubic-bezier(0.4, 0, 0.2, 1),
                  visibility 0s 0.42s;
      will-change: transform;
      z-index: 50;
      display: flex;
      flex-direction: column;
      padding: env(safe-area-inset-top, 0px) env(safe-area-inset-right, 0px)
               env(safe-area-inset-bottom, 0px) env(safe-area-inset-left, 0px);
    }
    body.panel-open #new-game-panel {
      transform: translateY(10%);
      visibility: visible;
      transition: transform 0.42s cubic-bezier(0.4, 0, 0.2, 1),
                  visibility 0s;
    }
    /* Panel header */
    #panel-header {
      display: flex;
      align-items: center;
      background: #07102e;
      padding: 6px 6px 6px 0px;
      height: 60px;
      min-height: 60px;
      flex-shrink: 0;
      clip-path: inset(0 -20px -20px -20px);
      box-shadow: 0 4px 10px rgba(0,0,0,0.23);
      position: relative;
      z-index: 1;
    }
    #panel-title {
      font-size: 0.9rem;
      font-weight: 600;
      color: #fff;
      letter-spacing: 0.01em;
      flex: 1;
    }
    #create-btn {
      background: rgba(255,213,0,0.88);
      border: none;
      border-radius: 999px;
      padding: 0 21px;
      height: 34px;
      font-family: 'Segoe UI', system-ui, sans-serif;
      font-size: 0.85rem;
      font-weight: 700;
      color: #07102e;
      cursor: pointer;
      flex-shrink: 0;
      transition: opacity 0.3s ease, transform 0.3s ease;
      -webkit-tap-highlight-color: transparent;
    }
    #create-btn:disabled {
      opacity: 0.35;
      cursor: default;
      transform: scale(0.9);
    }
    #create-btn.loading:disabled {
      transform: none;
    }
    #create-btn .btn-spinner {
      display: none;
      width: 16px;
      height: 16px;
      border: 2px solid rgba(7,16,46,0.25);
      border-top-color: #07102e;
      border-radius: 50%;
      animation: panelSpin 0.7s linear infinite;
    }
    #create-btn.loading {
      display: flex;
      align-items: center;
      justify-content: center;
    }
    #create-btn.loading .btn-text { display: none; }
    #create-btn.loading .btn-spinner { display: block; }
    #error-modal-backdrop {
      display: flex;
      position: absolute;
      inset: 0;
      background: rgba(0,0,0,0.45);
      z-index: 200;
      align-items: center;
      justify-content: center;
      padding: 24px;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.2s ease;
    }
    #error-modal-backdrop.open {
      opacity: 1;
      pointer-events: auto;
    }
    #error-modal {
      background: #fff;
      border-radius: 16px;
      padding: 18px 16px 14px;
      max-width: 400px;
      width: 100%;
      box-shadow: 0 8px 32px rgba(0,0,0,0.22);
      text-align: center;
    }
    #error-modal p {
      font-size: 1.05rem;
      font-weight: 600;
      color: #333;
      line-height: 1.45;
      margin-bottom: 14px;
    }
    #error-modal-ok {
      background: #07102e;
      color: #fff;
      border: none;
      border-radius: 999px;
      padding: 0 28px;
      height: 38px;
      font-family: 'Segoe UI', system-ui, sans-serif;
      font-size: 0.9rem;
      font-weight: 700;
      cursor: pointer;
      -webkit-tap-highlight-color: transparent;
      margin-top: 10px;
    }
    #close-panel {
      background: none;
      border: none;
      cursor: pointer;
      padding: 10px 12px 10px 8px;
      -webkit-tap-highlight-color: transparent;
      flex-shrink: 0;
    }
    #close-panel svg {
      width: 28px;
      height: 28px;
      stroke: #fff;
      stroke-width: 2.5;
      stroke-linecap: round;
      stroke-linejoin: round;
      display: block;
    }

    /* Spinner in main content while games load */
    #games-spinner {
      display: flex;
      justify-content: center;
      padding-top: 20px;
    }
    #games-spinner.hidden { display: none; }
    #games-spinner .panel-spin {
      width: 32px;
      height: 32px;
      border-color: rgba(0,0,0,0.12);
      border-top-color: #333;
    }

    /* Games section */
    #games-container {
      display: flex;
      flex-direction: column;
    }
    .games-title {
      font-size: 1.3rem;
      font-weight: 700;
      color: #333;
      padding: 26px 0 13px;
    }
    #games-list {
      margin-top: 4px;
    }

    /* Game row wrapper (swipe-to-delete) */
    .game-row-wrapper {
      position: relative;
      border-radius: 14px;
      margin-bottom: 16px;
    }
    .game-row-delete-action {
      position: absolute;
      left: 0;
      top: 0;
      height: 100%;
      width: 70px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: #e53935;
      border-radius: 14px 0 0 14px;
      cursor: pointer;
      -webkit-tap-highlight-color: transparent;
    }
    .delete-game-btn {
      background: none;
      border: none;
      color: #fff;
      pointer-events: none;
      padding: 0;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    /* Game row card */
    .game-row {
      background: #fff;
      border-radius: 14px;
      box-shadow: 0 2px 14px rgba(0,0,0,0.18);
      border: 1px solid rgba(0,0,0,0.07);
      overflow: hidden;
      position: relative;
      z-index: 1;
      will-change: transform;
      transition: transform 0.25s ease;
    }
    .game-row-header {
      padding: 8px 12px 0;
    }
    .game-category {
      display: block;
      font-size: 1rem;
      font-weight: 700;
      color: #333;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .game-row-body {
      display: flex;
      align-items: center;
      padding: 7px 8px 10px 12px;
      gap: 0;
    }
    .game-players {
      display: flex;
      gap: 6px;
      flex: 1;
      min-width: 0;
      flex-wrap: nowrap;
      overflow: hidden;
    }
    .game-player {
      display: flex;
      align-items: center;
      gap: 3px;
      flex-shrink: 0;
    }
    .player-avatar-wrap {
      position: relative;
      flex-shrink: 0;
      width: 24px;
      height: 24px;
    }
    .player-avatar {
      width: 24px;
      height: 24px;
      border-radius: 50%;
      object-fit: cover;
      border: 2px solid rgba(0,0,0,0.08);
      display: block;
    }
    .player-avatar-placeholder {
      width: 24px;
      height: 24px;
      border-radius: 50%;
      background: #e8eaf0;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.7rem;
      border: 2px solid rgba(0,0,0,0.06);
    }
    .player-answered-badge {
      position: absolute;
      bottom: -2px;
      right: -2px;
      width: 10px;
      height: 10px;
      border-radius: 50%;
      background: #43a047;
      border: 1.5px solid #fff;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .player-answered-badge svg {
      display: block;
    }
    .player-overflow-circle {
      width: 27px;
      height: 27px;
      border-radius: 50%;
      background: #e8eaf0;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.7rem;
      font-weight: 700;
      color: #555;
      flex-shrink: 0;
      line-height: 26px;
    }
    .game-player-info {
      display: flex;
      flex-direction: column;
      gap: 1px;
    }
    .player-name {
      font-size: 0.7rem;
      font-weight: 600;
      color: #222;
      max-width: 44px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .player-status {
      font-size: 0.65rem;
      font-weight: 600;
    }
    .player-status.answered { color: #2e7d32; }
    .player-status.waiting  { color: #bbb; }

    /* Answer button */
    @keyframes answerPulse {
      0%   { box-shadow: 0 2px 8px rgba(0,0,0,0.12), 0 0 0 0   rgba(255,213,0,0.55); }
      100% { box-shadow: 0 2px 8px rgba(0,0,0,0.12), 0 0 0 10px rgba(255,213,0,0); }
    }
    .answer-btn {
      flex-shrink: 0;
      margin-left: auto;
      align-self: center;
      position: relative;
      top: -10px;
      background: rgba(255,213,0,0.88);
      border: none;
      border-radius: 999px;
      padding: 0 14px;
      height: 30px;
      font-family: 'Segoe UI', system-ui, sans-serif;
      font-size: 0.8rem;
      font-weight: 700;
      color: #07102e;
      cursor: pointer;
      -webkit-tap-highlight-color: transparent;
      animation: answerPulse 1.4s ease-out infinite;
      will-change: box-shadow;
    }
    .answer-btn:active { transform: scale(0.93); }

    /* Summary bar */
    .game-row-summary {
      background: #f5f5f5;
      padding: 6px 12px;
      font-size: 0.7rem;
      font-weight: 500;
      color: #888;
      text-align: center;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      opacity: 0.87;
    }

    /* Row fade-in */
    @keyframes rowFadeIn {
      from { opacity: 0; transform: translateY(6px); }
      to   { opacity: 1; transform: translateY(0); }
    }
    .game-row-wrapper {
      animation: rowFadeIn 0.3s ease both;
    }

    /* Delete confirmation modal */
    #delete-modal-backdrop {
      display: flex;
      position: absolute;
      inset: 0;
      background: rgba(0,0,0,0.45);
      z-index: 200;
      align-items: center;
      justify-content: center;
      padding: 24px;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.2s ease;
    }
    #delete-modal-backdrop.open {
      opacity: 1;
      pointer-events: auto;
    }
    #delete-modal {
      background: #fff;
      border-radius: 16px;
      padding: 22px 20px 18px;
      max-width: 400px;
      width: 100%;
      box-shadow: 0 8px 32px rgba(0,0,0,0.22);
      text-align: center;
    }
    #delete-modal p {
      font-size: 1.05rem;
      font-weight: 600;
      color: #333;
      line-height: 1.45;
      margin-bottom: 18px;
    }
    .delete-modal-buttons {
      display: flex;
      gap: 10px;
      justify-content: center;
    }
    #delete-modal-cancel {
      background: #e0e0e0;
      color: #555;
      border: none;
      border-radius: 999px;
      width: 100px;
      height: 38px;
      font-family: 'Segoe UI', system-ui, sans-serif;
      font-size: 0.9rem;
      font-weight: 700;
      cursor: pointer;
      -webkit-tap-highlight-color: transparent;
    }
    #delete-modal-confirm {
      background: rgba(255,213,0,0.88);
      color: #07102e;
      border: none;
      border-radius: 999px;
      width: 100px;
      height: 38px;
      font-family: 'Segoe UI', system-ui, sans-serif;
      font-size: 0.9rem;
      font-weight: 700;
      cursor: pointer;
      -webkit-tap-highlight-color: transparent;
    }

    /* Spinner inside panel */
    #panel-spinner {
      display: flex;
      justify-content: center;
      padding-top: 36px;
      flex: 1;
      background: #fff;
    }
    #panel-spinner.hidden { display: none; flex: none; }
    .panel-spin {
      width: 32px;
      height: 32px;
      border: 4px solid rgba(7,16,46,0.15);
      border-top-color: #07102e;
      border-radius: 50%;
      animation: panelSpin 0.7s linear infinite;
    }
    @keyframes panelSpin {
      to { transform: rotate(360deg); }
    }

    /* Pull-to-refresh indicator */
    #ptr-indicator,
    #games-ptr-indicator {
      display: flex;
      justify-content: center;
      align-items: flex-start;
      height: 0;
      overflow: hidden;
      flex-shrink: 0;
      will-change: height;
    }
    #ptr-indicator.ptr-snap,
    #games-ptr-indicator.ptr-snap {
      transition: height 0.18s ease, opacity 0.275s ease;
    }
    #ptr-spinner,
    #games-ptr-spinner {
      width: 24px;
      height: 24px;
      border: 3px solid rgba(0,0,0,0.12);
      border-top-color: #333;
      border-radius: 50%;
      flex-shrink: 0;
      will-change: transform;
      margin-top: 8px;
    }
    #ptr-spinner.ptr-spinning,
    #games-ptr-spinner.ptr-spinning {
      animation: panelSpin 0.7s linear infinite;
    }

    /* Users list */
    #users-list {
      flex: 1;
      padding: 0;
      transition: opacity 0.36s ease;
      will-change: transform;
      background: #fff;
      box-shadow: 0 1px 0 #f0f0f0;
      overflow: hidden;
    }
    #users-list-scroller {
      overflow-y: auto;
      overscroll-behavior-y: contain;
      height: 100%;
    }
    @media (display-mode: standalone) {
      body {
        overflow: clip;
      }
      #new-game-panel {
        padding-bottom: 0;
      }

    }
    .user-row {
      display: flex;
      align-items: center;
      gap: 14px;
      padding: 7px 12px;
      border-bottom: 1px solid #f0f0f0;
      cursor: pointer;
      -webkit-tap-highlight-color: transparent;
      touch-action: manipulation;
    }
    .user-row:first-child { border-top: 1px solid #f0f0f0; }
    .user-row:last-child { border-bottom: none; }
    .user-row:has(input:checked) { background: #fafbff; }
    .user-row input[type="checkbox"] {
      appearance: none;
      -webkit-appearance: none;
      width: 19px;
      height: 19px;
      border-radius: 50%;
      border: 2px solid #ccc;
      margin-left: auto;
      flex-shrink: 0;
      transition: border-color 0.15s, background 0.15s;
      cursor: pointer;
      touch-action: manipulation;
    }
    .user-row input[type="checkbox"]:checked {
      border-color: #07102e;
      background: #07102e;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 10 8' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M1 4l3 3 5-6' stroke='%23fff' stroke-width='1.8' fill='none' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E");
      background-repeat: no-repeat;
      background-position: center;
      background-size: 12px 10px;
    }
    .user-row img, .user-row .user-avatar-placeholder {
      width: 39px;
      height: 39px;
      border-radius: 50%;
      object-fit: cover;
      flex-shrink: 0;
      border: 1px solid transparent;
      box-sizing: border-box;
    }
    .user-row:has(input:checked) img,
    .user-row:has(input:checked) .user-avatar-placeholder {
      border-color: #888;
    }
    .user-avatar-placeholder {
      background: #e8eaf0;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 1.3rem;
    }
    .user-row:has(input:checked) .user-name { color: #333; }
    .user-name {
      font-size: 1rem;
      font-weight: 500;
      color: #222;
      min-width: 0;
      flex: 1;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

</style>
</head>
<body>
  <div id="dashboard-root">
    <div class="topbar">
      <img class="topbar-header-img" src="data:image/webp;base64," alt="" />
      <div class="topbar-user" id="topbar-user">
        <div id="avatar-wrap"><div class="spinner"></div></div>
        <span id="topbar-greeting" class="topbar-greeting" style="display:none"></span>
        <div id="user-popover">
          <button id="logout-btn">Logout<svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex-shrink:0"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg></button>
        </div>
      </div>
    </div>

    <div class="content" id="content">
      <div id="games-ptr-indicator"><div id="games-ptr-spinner"></div></div>
      <div id="games-container">
        <h2 class="games-title">Your Games</h2>
        <div id="games-spinner" class="hidden"><div class="panel-spin"></div></div>
        <div id="games-list"></div>
      </div>
    </div>

    <button class="fab" id="new-game" aria-label="New game" style="opacity:0">
      <svg viewBox="0 0 24 24" fill="none"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
      New Game
    </button>

  <div id="new-game-panel">
    <div id="panel-header">
      <button id="close-panel" aria-label="Back">
        <svg viewBox="0 0 24 24" fill="none"><polyline points="15 18 9 12 15 6"/></svg>
      </button>
      <span id="panel-title">Select Friends For a Game</span>
      <button id="create-btn" disabled><span class="btn-text">Create</span><div class="btn-spinner"></div></button>
    </div>
    <div id="panel-spinner"><div class="panel-spin"></div></div>
    <div id="ptr-indicator"><div id="ptr-spinner"></div></div>
    <div id="users-list"><div id="users-list-scroller"></div></div>
  </div>
  </div>

  <div id="delete-modal-backdrop">
    <div id="delete-modal">
      <p>Are you sure you want to delete this game?</p>
      <div class="delete-modal-buttons">
        <button id="delete-modal-cancel">Cancel</button>
        <button id="delete-modal-confirm">Yes</button>
      </div>
    </div>
  </div>

  <div id="error-modal-backdrop">
    <div id="error-modal">
      <p id="error-modal-msg"></p>
      <button id="error-modal-ok">OK</button>
    </div>
  </div>

  <script>
    document.addEventListener('touchmove', (e) => { if (e.touches.length > 1) e.preventDefault(); }, { passive: false });
    const userId = localStorage.getItem('userId');
    let currentUser = null;
    if (!userId) {
      location.replace('/');
    } else {
      fetch(`/api/me?userId=${encodeURIComponent(userId)}`)
        .then(r => r.ok ? r.json() : Promise.reject())
        .then(user => {
          currentUser = user;
          const wrap = document.getElementById('avatar-wrap');
          wrap.innerHTML = user.avatar_url
            ? `<img class="avatar" src="${user.avatar_url}" alt="${user.display_name}" />`
            : `<div class="avatar-placeholder">👤</div>`;
          const parts = user.display_name ? user.display_name.trim().split(' ') : [];
          const firstName = parts[0] || '';
          const initials = parts.length >= 2 ? parts[0][0].toUpperCase() + parts[parts.length - 1][0].toUpperCase() : (parts[0] ? parts[0][0].toUpperCase() : '');
          if (firstName) {
            const greeting = document.getElementById('topbar-greeting');
            const label = firstName.length <= 7 ? firstName : initials;
            greeting.textContent = `Hi, ${label}`;
            greeting.style.display = '';
          }
        })
        .catch(() => location.replace('/'));

      setTimeout(() => loadGames(), 500);
    }

    document.getElementById('topbar-user').addEventListener('click', e => {
      e.stopPropagation();
      document.getElementById('user-popover').classList.toggle('open');
    });
    document.addEventListener('click', () => {
      document.getElementById('user-popover').classList.remove('open');
    });
    document.getElementById('logout-btn').addEventListener('click', () => {
      localStorage.removeItem('userId');
      location.replace('/');
    });

    function openPanel() {
      document.body.classList.add('panel-open');
    }
    function closePanel() {
      document.body.classList.remove('panel-open');
      document.getElementById('create-btn').disabled = true;
    }

    document.getElementById('new-game').addEventListener('click', () => {
      openPanel();
      loadUsers();
    });
    document.getElementById('close-panel').addEventListener('click', closePanel);

    function showErrorModal(msg) {
      document.getElementById('error-modal-msg').textContent = msg;
      document.getElementById('error-modal-backdrop').classList.add('open');
    }
    document.getElementById('error-modal-ok').addEventListener('click', () => {
      document.getElementById('error-modal-backdrop').classList.remove('open');
    });

    function updateCreateBtn() {
      const anyChecked = document.querySelector('#users-list input:checked');
      document.getElementById('create-btn').disabled = !anyChecked;
    }

    document.getElementById('create-btn').addEventListener('click', async () => {
      const checked = [...document.querySelectorAll('#users-list input:checked')];
      if (!checked.length) return;

      const friendIds = checked.map(cb => Number(cb.closest('.user-row').dataset.userId));
      const btn = document.getElementById('create-btn');
      const rows = [...document.querySelectorAll('#users-list .user-row')];

      function reEnableRows() {
        btn.style.width = '';
        btn.classList.remove('loading');
        btn.disabled = false;
        rows.forEach(row => {
          row.style.pointerEvents = '';
          row.style.opacity = '';
          row.querySelector('input').disabled = false;
        });
      }

      // Disable UI and show spinner in button (lock width first so it doesn't shrink)
      btn.style.width = btn.offsetWidth + 'px';
      btn.disabled = true;
      btn.classList.add('loading');
      rows.forEach(row => {
        row.style.pointerEvents = 'none';
        row.style.opacity = '0.45';
        row.querySelector('input').disabled = true;
      });

      try {
        const res = await fetch('/api/games', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ userId, friendIds }),
        });

        if (res.ok) {
          await loadGames(true);
          closePanel();
          btn.style.width = '';
          btn.classList.remove('loading');
          btn.disabled = true;
        } else {
          const data = await res.json();
          reEnableRows();
          showErrorModal(res.status === 409 ? data.error : 'Sorry, something went wrong');
        }
      } catch (e) {
        reEnableRows();
        showErrorModal('Sorry, something went wrong');
      }
    });

    function escHtml(str) {
      return String(str ?? '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
    }

    function loadGames(silent = false) {
      const fab = document.getElementById('new-game');
      const spinner = document.getElementById('games-spinner');
      if (!silent) spinner.classList.remove('hidden');
      const delay = silent ? Promise.resolve() : new Promise(res => setTimeout(res, 1000));
      const fetch$ = fetch(`/api/games?userId=${encodeURIComponent(userId)}`)
        .then(r => r.ok ? r.json() : Promise.reject());

      return Promise.all([fetch$, delay])
        .then(([games]) => {
          if (!silent) {
            spinner.classList.add('hidden');
            setTimeout(() => { fab.style.opacity = '1'; }, 200);
          }
          fab.classList.toggle('fab-pulse', Array.isArray(games) && games.length === 0);
          renderGames(games);
        })
        .catch(() => {
          if (!silent) {
            spinner.classList.add('hidden');
            setTimeout(() => { fab.style.opacity = '1'; }, 200);
          }
        });
    }

    function renderGames(games) {
      const list = document.getElementById('games-list');
      if (!Array.isArray(games) || games.length === 0) {
        list.innerHTML = '';
        return;
      }

      const MAX_VISIBLE = 3;
      const toTitleCase = str => str.toLowerCase().replace(/\b\w/g, c => c.toUpperCase());

      list.innerHTML = games.map((game, idx) => {
        const rawCategory = game.current_question ? game.current_question.category : 'No question yet';
        const category = `Category: ${toTitleCase(rawCategory)}`;
        const cqId = game.current_question ? game.current_question.game_question_id : null;
        const iAnswered = cqId && game.my_answers && game.my_answers.some(a => a.game_question_id === cqId);

        // Build combined player list: others first, current user last
        const others = game.players || [];
        const meEntry = currentUser ? { ...currentUser, _isMe: true, _answered: iAnswered } : null;
        const combined = meEntry ? [...others.map(p => ({ ...p, _answered: false })), meEntry] : others.map(p => ({ ...p, _answered: false }));

        const overflow = combined.length > MAX_VISIBLE ? combined.length - MAX_VISIBLE : 0;
        const visible = overflow > 0 ? combined.slice(0, MAX_VISIBLE) : combined;

        const playerHtml = visible.map(p => {
          const rawName = (p.display_name || '').trim();
          const parts = rawName.split(' ');
          const fn = parts[0] || '';
          const initials = parts.length >= 2
            ? parts[0][0].toUpperCase() + parts[parts.length - 1][0].toUpperCase()
            : (parts[0] ? parts[0][0].toUpperCase() : '');
          const displayName = escHtml(fn.length <= 5 ? fn : initials);
          const avatarInner = p.avatar_url
            ? `<img class="player-avatar" src="${escHtml(p.avatar_url)}" alt="${displayName}" />`
            : `<div class="player-avatar-placeholder">👤</div>`;
          const badge = p._answered
            ? `<div class="player-answered-badge"><svg width="6" height="6" viewBox="0 0 6 6" fill="none"><polyline points="1,3 2.5,4.5 5,1.5" stroke="#fff" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"/></svg></div>`
            : '';
          const avatarHtml = `<div class="player-avatar-wrap">${avatarInner}${badge}</div>`;
          const statusClass = p._answered ? 'answered' : 'waiting';
          const statusText = p._answered ? 'Answered' : 'Waiting';
          return `<div class="game-player">
            ${avatarHtml}
            <div class="game-player-info">
              <span class="player-name">${displayName}</span>
              <span class="player-status ${statusClass}">${statusText}</span>
            </div>
          </div>`;
        }).join('');

        const overflowHtml = overflow > 0
          ? `<div class="game-player"><div class="player-overflow-circle">+${overflow}</div></div>`
          : '';

        return `<div class="game-row-wrapper" data-game-id="${escHtml(game.id)}" style="animation-delay:${idx * 0.06}s">
          <div class="game-row-delete-action">
            <button class="delete-game-btn" aria-label="Delete game">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="3 6 5 6 21 6"></polyline>
                <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
              </svg>
            </button>
          </div>
          <div class="game-row">
            <div class="game-row-header">
              <span class="game-category">${escHtml(category)}</span>
            </div>
            <div class="game-row-body">
              <div class="game-players">${playerHtml}${overflowHtml}</div>
              <button class="answer-btn">Answer</button>
            </div>
            <div class="game-row-summary">A new question is coming after everyone answers</div>
          </div>
        </div>`;
      }).join('');

      setupSwipeToDelete();
    }

    function setupSwipeToDelete() {
      const DELETE_W = 70;
      // Track whether the content container is scrolling vertically
      let contentIsScrolling = false;
      let contentScrollTimer = null;
      const contentEl = document.getElementById('content');
      if (contentEl) {
        contentEl.addEventListener('scroll', () => {
          contentIsScrolling = true;
          clearTimeout(contentScrollTimer);
          contentScrollTimer = setTimeout(() => { contentIsScrolling = false; }, 150);
        }, { passive: true });
      }

      document.querySelectorAll('.game-row-wrapper').forEach(wrapper => {
        const row = wrapper.querySelector('.game-row');
        const deleteAction = wrapper.querySelector('.game-row-delete-action');
        let startX = 0, startY = 0, startTx = 0;
        let tracking = false, isOpen = false;
        let dirLocked = null; // 'h' | 'v' | null
        let lastTouchX = 0, lastTouchTime = 0, velocityX = 0;

        const getTx = () => {
          const m = row.style.transform.match(/translateX\(([-\d.]+)px\)/);
          return m ? parseFloat(m[1]) : 0;
        };
        const snapTo = (tx) => {
          row.style.transition = 'transform 0.22s cubic-bezier(0.25, 0.46, 0.45, 0.94)';
          row.style.transform = tx > 0 ? `translateX(${tx}px)` : '';
          isOpen = tx > 0;
          setTimeout(() => { row.style.transition = ''; }, 230);
        };

        row.addEventListener('touchstart', e => {
          if (e.touches.length !== 1) return;
          if (contentIsScrolling) return;
          startX = e.touches[0].clientX;
          startY = e.touches[0].clientY;
          startTx = getTx();
          tracking = true;
          dirLocked = null;
          lastTouchX = startX;
          lastTouchTime = Date.now();
          velocityX = 0;
          row.style.transition = '';
        }, { passive: true });

        row.addEventListener('touchmove', e => {
          if (!tracking || e.touches.length !== 1) return;
          const cx = e.touches[0].clientX;
          const cy = e.touches[0].clientY;
          const dx = cx - startX;
          const dy = cy - startY;

          // Lock direction on first significant movement
          if (!dirLocked) {
            if (Math.abs(dx) > 5 || Math.abs(dy) > 5) {
              dirLocked = Math.abs(dx) >= Math.abs(dy) ? 'h' : 'v';
            } else {
              return;
            }
          }

          if (dirLocked === 'v') {
            // Vertical scroll — cancel horizontal tracking, snap to stable state
            tracking = false;
            snapTo(isOpen ? DELETE_W : 0);
            return;
          }

          // Horizontal swipe — block scroll and pull-to-refresh
          e.preventDefault();

          // Track velocity
          const now = Date.now();
          const dt = now - lastTouchTime;
          if (dt > 0) velocityX = (cx - lastTouchX) / dt;
          lastTouchX = cx;
          lastTouchTime = now;

          const newTx = Math.max(0, Math.min(DELETE_W, startTx + dx));
          row.style.transform = newTx > 0 ? `translateX(${newTx}px)` : '';
        }, { passive: false });

        row.addEventListener('touchend', () => {
          if (!tracking) return;
          tracking = false;
          const currentTx = getTx();
          // Use velocity to determine intent: fast rightward → open, fast leftward → close
          let shouldOpen;
          if (velocityX > 0.3) {
            shouldOpen = true;
          } else if (velocityX < -0.3) {
            shouldOpen = false;
          } else {
            shouldOpen = currentTx > DELETE_W / 2;
          }
          snapTo(shouldOpen ? DELETE_W : 0);
        });

        row.addEventListener('touchcancel', () => {
          if (!tracking) return;
          tracking = false;
          snapTo(isOpen ? DELETE_W : 0);
        });

        // Tap on the row content while open → close it
        row.addEventListener('click', () => {
          if (isOpen) { snapTo(0); }
        });

        deleteAction.addEventListener('click', e => {
          e.stopPropagation();
          snapTo(0);
          document.getElementById('delete-modal-backdrop').classList.add('open');
        });
      });
    }

    // Delete modal close handlers
    document.getElementById('delete-modal-cancel').addEventListener('click', () => {
      document.getElementById('delete-modal-backdrop').classList.remove('open');
    });
    document.getElementById('delete-modal-confirm').addEventListener('click', () => {
      document.getElementById('delete-modal-backdrop').classList.remove('open');
    });

    let usersCache = null;
    let usersCacheAt = 0;

    function loadUsers(silent = false) {
      const spinner = document.getElementById('panel-spinner');
      const list = document.getElementById('users-list');
      const scroller = document.getElementById('users-list-scroller');
      if (!silent) {
        spinner.classList.remove('hidden');
        scroller.innerHTML = '';
      }

      const now = Date.now();
      const cached = usersCache && now - usersCacheAt < 60_000;
      const delay = cached ? Promise.resolve() : new Promise(res => setTimeout(res, 400));
      const fetchUsers = cached
        ? Promise.resolve(usersCache)
        : fetch(`/api/users?userId=${encodeURIComponent(userId)}`)
            .then(r => r.ok ? r.json() : Promise.reject())
            .then(data => { usersCache = data; usersCacheAt = Date.now(); return data; });
      if (cached && !silent) spinner.classList.add('hidden');

      return Promise.all([fetchUsers, delay])
        .then(([users]) => {
          if (!silent) spinner.classList.add('hidden');
          const applyUsers = () => {
            const selected = new Set([...scroller.querySelectorAll('.user-row input:checked')]
              .map(cb => cb.closest('.user-row').dataset.userId));
            scroller.innerHTML = users.map(u => `
              <div class="user-row" data-user-id="${u.id}" onclick="this.querySelector('input').click()">
                ${u.avatar_url
                  ? `<img src="${u.avatar_url}" alt="${u.display_name}" />`
                  : `<div class="user-avatar-placeholder">👤</div>`}
                <span class="user-name">${u.display_name}</span>
                <input type="checkbox" onclick="event.stopPropagation()" onchange="updateCreateBtn()" />
              </div>
            `).join('');
            scroller.querySelectorAll('.user-row').forEach(row => {
              if (selected.has(row.dataset.userId)) row.querySelector('input').checked = true;
            });
            updateCreateBtn();
            list.style.opacity = '1';
          };
          if (silent && scroller.querySelector('.user-row')) {
            list.style.opacity = '0';
            setTimeout(applyUsers, 360);
          } else {
            applyUsers();
          }
        })
        .catch(() => {
          if (!silent) spinner.classList.add('hidden');
          scroller.innerHTML = '<p style="padding:16px;color:#888;">Could not load users.</p>';
        });
    }

    // Pull-to-refresh + bottom overscroll on #users-list
    (function() {
      const list = document.getElementById('users-list');
      const scroller = document.getElementById('users-list-scroller');
      const ptr = document.getElementById('ptr-indicator');
      const ptrSpinner = document.getElementById('ptr-spinner');
      const THRESHOLD = 125;
      const DEADZONE = 36;
      let startY = 0, mode = null, triggered = false, lastDy = 0;
      // mode: null = undecided/native | 'ptr' = pull-to-refresh | 'push' = bottom overscroll

      const snapBack = () => {
        if (list.style.transform) {
          list.style.transition = 'transform 0.35s cubic-bezier(0.25, 0.46, 0.45, 0.94)';
          list.style.transform = '';
          setTimeout(() => { list.style.transition = ''; }, 350);
        }
      };

      list.addEventListener('touchstart', e => {
        if (e.touches.length !== 1) return;
        startY = e.touches[0].clientY;
        mode = null;
        triggered = false;
        lastDy = 0;
        list.style.transition = '';
        ptr.classList.remove('ptr-snap');
      }, { passive: true });

      list.addEventListener('touchmove', e => {
        const dy = e.touches[0].clientY - startY;

        // Determine gesture mode on first significant movement
        if (mode === null) {
          if (dy > 3 && scroller.scrollTop <= 0) {
            mode = 'ptr';
            startY = e.touches[0].clientY;
            ptr.style.height = '0';
            ptrSpinner.style.transform = 'rotate(0deg)';
          } else if (dy < -3 && scroller.scrollTop >= scroller.scrollHeight - scroller.clientHeight - 1) {
            mode = 'push';
            startY = e.touches[0].clientY;
          } else {
            return; // let native scroll handle it
          }
        }

        const d = e.touches[0].clientY - startY;
        if (mode === 'ptr') {
          e.preventDefault();
          list.style.transform = '';
          if (d > 0) {
            const edy = Math.max(0, d - DEADZONE);
            lastDy = d;
            ptr.style.height = (edy * 0.44) + 'px';
            const spinEdy = Math.max(0, edy - 18);
            ptrSpinner.style.transform = `rotate(${Math.min(spinEdy * 0.44 / 56 * 360, 360)}deg)`;
            triggered = d >= THRESHOLD;
          } else {
            // Pulled back — reset visuals but stay in ptr mode so gesture can recover
            triggered = false;
            ptr.style.height = '0';
          }
        } else if (mode === 'push') {
          e.preventDefault();
          list.style.transform = d < 0 ? `translateY(${d * 0.41}px)` : '';
        }
      }, { passive: false });

      list.addEventListener('touchend', () => {
        if (mode === null) return;
        const wasMode = mode;
        mode = null;
        snapBack();
        if (wasMode === 'ptr') {
          ptr.classList.add('ptr-snap');
          if (triggered) {
            triggered = false;
            ptr.style.height = '48px';
            ptrSpinner.style.animationDelay = `${-(Math.min(Math.max(lastDy - 36, 0) * 0.45 / 56 * 360, 360) % 360) / 360 * 0.7}s`;
            ptrSpinner.style.transform = '';
            requestAnimationFrame(() => {
              ptrSpinner.classList.add('ptr-spinning');
            });
            usersCache = null;
            loadUsers(true).finally(() => {
              setTimeout(() => {
                ptrSpinner.style.transform = getComputedStyle(ptrSpinner).transform;
                ptrSpinner.classList.remove('ptr-spinning');
                ptrSpinner.style.animationDelay = '';
                requestAnimationFrame(() => {
                  ptr.style.opacity = '0';
                  setTimeout(() => {
                    ptr.style.height = '0';
                    setTimeout(() => { ptr.classList.remove('ptr-snap'); ptr.style.opacity = ''; }, 180);
                  }, 275);
                });
              }, 640);
            });
          } else {
            ptr.style.height = '0';
          }
        }
      });
      list.addEventListener('touchcancel', () => { mode = null; snapBack(); });
    })();

    // Pull-to-refresh on #content (games list)
    (function() {
      const content = document.getElementById('content');
      const ptr = document.getElementById('games-ptr-indicator');
      const ptrSpinner = document.getElementById('games-ptr-spinner');
      const _standalone = window.navigator.standalone === true;
      const THRESHOLD = 125;
      const DEADZONE = 36;
      let startY = 0, pulling = false, triggered = false, lastDy = 0;

      const snapBack = () => {
        if (content.style.transform) {
          content.style.transition = 'transform 0.35s cubic-bezier(0.25, 0.46, 0.45, 0.94)';
          content.style.transform = '';
          setTimeout(() => { content.style.transition = ''; }, 350);
        }
      };

      content.addEventListener('touchstart', e => {
        if (content.scrollTop === 0 && e.touches.length === 1) {
          startY = e.touches[0].clientY;
          pulling = true;
          triggered = false;
          content.style.transition = '';
          ptr.classList.remove('ptr-snap');
          ptr.style.height = '0';
          ptrSpinner.style.transform = 'rotate(0deg)';
        }
      }, { passive: true });

      content.addEventListener('touchmove', e => {
        if (!pulling) return;
        const dy = e.touches[0].clientY - startY;
        e.preventDefault();
        if (dy > 0) {
          const edy = Math.max(0, dy - DEADZONE);
          content.style.transform = '';
          lastDy = dy;
          ptr.style.height = (edy * 0.44) + 'px';
          const spinEdy = Math.max(0, edy - 18);
          ptrSpinner.style.transform = `rotate(${Math.min(spinEdy * 2, 360)}deg)`;
          triggered = dy >= THRESHOLD;
        } else {
          triggered = false;
          ptr.style.height = '0';
          content.style.transform = `translateY(${dy * 0.55}px)`;
        }
      }, { passive: false });

      content.addEventListener('touchend', () => {
        if (!pulling) return;
        pulling = false;
        snapBack();
        ptr.classList.add('ptr-snap');
        if (triggered) {
          ptr.style.height = '48px';
          ptrSpinner.style.animationDelay = `${-(Math.min(Math.max(lastDy - 36, 0) * 2, 360) % 360) / 360 * 0.7}s`;
          ptrSpinner.style.transform = '';
          requestAnimationFrame(() => {
            ptrSpinner.classList.add('ptr-spinning');
          });
          loadGames(true).finally(() => {
            ptrSpinner.style.transform = getComputedStyle(ptrSpinner).transform;
            ptrSpinner.classList.remove('ptr-spinning');
            ptrSpinner.style.animationDelay = '';
            requestAnimationFrame(() => {
              ptr.style.opacity = '0';
              setTimeout(() => {
                ptr.style.height = '0';
                setTimeout(() => { ptr.classList.remove('ptr-snap'); ptr.style.opacity = ''; }, 180);
              }, 275);
            });
          });
        } else {
          ptr.style.height = '0';
        }
      });
      content.addEventListener('touchcancel', () => { pulling = false; snapBack(); });
    })();
  </script>
</body>
</html>
