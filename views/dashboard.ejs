<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="theme-color" content="#07102e" />
  <link rel="manifest" href="/manifest.json" />
  <title>Final Jeopardy! With Friends</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      background: #07102e;
      min-height: 100vh;
      min-height: 100dvh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      font-family: 'Segoe UI', system-ui, sans-serif;
      color: #fff;
      padding: env(safe-area-inset-top, 0px) env(safe-area-inset-right, 0px) env(safe-area-inset-bottom, 0px) env(safe-area-inset-left, 0px);
    }

    .card {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 1.25rem;
      opacity: 0;
      animation: fadeIn 0.25s ease forwards;
      animation-delay: 0.1s;
    }

    @keyframes fadeIn {
      to { opacity: 1; }
    }

    .avatar {
      width: 96px;
      height: 96px;
      border-radius: 50%;
      object-fit: cover;
      border: 3px solid rgba(255,255,255,0.15);
    }

    .avatar-placeholder {
      width: 96px;
      height: 96px;
      border-radius: 50%;
      background: rgba(255,255,255,0.1);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 2.5rem;
    }

    .greeting {
      font-size: 1.6rem;
      font-weight: 700;
      text-align: center;
    }
  </style>
</head>
<body>
  <div class="card" id="card"></div>

  <script>
    const userId = localStorage.getItem('userId');
    if (!userId) {
      location.replace('/');
    } else {
      fetch(`/api/me?userId=${encodeURIComponent(userId)}`)
        .then(r => r.ok ? r.json() : Promise.reject())
        .then(user => {
          const card = document.getElementById('card');
          const avatarHtml = user.avatar_url
            ? `<img class="avatar" src="${user.avatar_url}" alt="${user.display_name}" />`
            : `<div class="avatar-placeholder">👤</div>`;
          card.innerHTML = `
            ${avatarHtml}
            <p class="greeting">Hello, ${user.display_name}!</p>
          `;
        })
        .catch(() => location.replace('/'));
    }
  </script>
</body>
</html>
