<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>First 5 Questions – Final Jeopardy!</title>
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <div style="max-width:800px;margin:2rem auto;padding:0 1rem;">
    <h1>First 5 Questions</h1>
    <% questions.forEach(function(q) { %>
      <div style="border:1px solid #ccc;border-radius:6px;padding:1rem;margin-bottom:1rem;">
        <p style="font-size:0.85rem;color:#666;margin:0 0 0.25rem;">
          #<%= q.id %> &mdash; <strong><%= q.category %></strong>
        </p>
        <p style="margin:0 0 0.5rem;"><strong>Q:</strong> <%= q.question %></p>
        <p style="margin:0;color:#1a5276;"><strong>A:</strong> <%= q.answer %></p>
      </div>
    <% }); %>
  </div>
</body>
</html>
