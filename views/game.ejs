<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="default" />
  <meta name="apple-mobile-web-app-title" content="Final Jeopardy" />
  <meta name="theme-color" content="#07102e" />
  <link rel="manifest" href="/manifest.json" />
  <link rel="icon" type="image/x-icon" href="/images/favicon.ico" />
  <link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32x32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/images/favicon-16x16.png" />
  <link rel="apple-touch-icon" href="/images/hone-screen-new.png" />
  <title>Final Jeopardy With Friends</title>
  <script>
    // Signal to dashboard that we're coming back from game, for the reverse transition.
    window.addEventListener('pageswap', e => {
      if (e.viewTransition) sessionStorage.setItem('vt-from-game', '1');
    });
  </script>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    /* Slide in from right over dashboard; dashboard parallaxes left */
    @view-transition { navigation: auto; }

    @keyframes slide-in-from-right {
      from { transform: translateX(100%); }
      to   { transform: translateX(0); }
    }
    @keyframes parallax-out-left {
      from { transform: translateX(0);    opacity: 1;    }
      to   { transform: translateX(-25%); opacity: 0.85; }
    }

    ::view-transition-new(root) {
      animation: slide-in-from-right 0.42s cubic-bezier(0.25, 0.46, 0.45, 0.94) both;
      z-index: 2;
    }
    ::view-transition-old(root) {
      animation: parallax-out-left 0.42s cubic-bezier(0.25, 0.46, 0.45, 0.94) both;
      z-index: 1;
    }

    body {
      touch-action: manipulation;
      background: #07102e;
      height: 100vh;
      height: 100dvh;
      overflow: hidden;
      font-family: 'Segoe UI', system-ui, sans-serif;
      color: #fff;
      padding: env(safe-area-inset-top, 0px) env(safe-area-inset-right, 0px) env(safe-area-inset-bottom, 0px) env(safe-area-inset-left, 0px);
      position: relative;
    }

    /* Back button */
    #back-btn {
      position: fixed;
      top: calc(env(safe-area-inset-top, 0px) + 14px);
      left: calc(env(safe-area-inset-left, 0px) + 10px);
      display: flex;
      align-items: center;
      gap: 4px;
      background: none;
      border: none;
      color: rgba(255,255,255,0.85);
      font-size: 1.05rem;
      font-family: inherit;
      cursor: pointer;
      padding: 8px 10px;
      border-radius: 10px;
      -webkit-tap-highlight-color: transparent;
      z-index: 10;
      transition: opacity 0.15s;
    }
    #back-btn:active { opacity: 0.55; }
    #back-btn svg { flex-shrink: 0; }

    /* Spinner */
    @keyframes spin {
      to { transform: translateX(-50%) rotate(360deg); }
    }
    #spinner {
      position: absolute;
      top: 175px;
      left: 50%;
      transform: translateX(-50%);
      width: 50px;
      height: 50px;
      border: 3.5px solid rgba(255,255,255,0.25);
      border-top-color: #fff;
      border-radius: 50%;
      animation: spin 0.75s linear infinite;
      transition: opacity 0.3s ease;
    }
    #spinner.hidden { opacity: 0; pointer-events: none; }

    /* Category content */
    #category-label {
      position: absolute;
      top: calc(env(safe-area-inset-top, 0px) + 80px);
      left: 0; right: 0;
      text-align: center;
      font-size: 1.5rem;
      font-weight: 700;
      letter-spacing: 0.04em;
      color: #fff;
      text-shadow: 0 2px 12px rgba(0,0,0,0.6), 0 0 24px rgba(255,255,255,0.15);
      opacity: 0;
      transition: opacity 1.35s ease;
      padding-right: 1.8rem;
    }
    #category-label .dots {
      display: inline-block;
      position: absolute;
      margin-left: 0.04em;
    }
    #category-label.visible { opacity: 1; }

    #category-text {
      position: absolute;
      top: calc(env(safe-area-inset-top, 0px) + 95px);
      left: 40px; right: 40px;
      text-align: center;
      font-size: 1.5rem;
      font-weight: 600;
      color: #fff;
      text-shadow: 0 2px 8px rgba(0,0,0,0.35);
      opacity: 0;
      transition: opacity 1.35s ease;
      line-height: 1.35;
    }
    #category-text.visible { opacity: 1; }

    /* Answer button */
    @keyframes answerPulse {
      0%   { box-shadow: 0 4px 20px rgba(0,0,0,0.25), 0 0 0 0 rgba(255,215,0,0.55); }
      100% { box-shadow: 0 4px 20px rgba(0,0,0,0.25), 0 0 0 16px rgba(255,215,0,0); }
    }
    #answer-btn {
      position: fixed;
      bottom: calc(env(safe-area-inset-bottom, 0px) + 28px);
      left: 50%;
      transform: translateX(-50%);
      width: calc(100% - 40px);
      background: #FFD700;
      color: #07102e;
      border: none;
      border-radius: 50px;
      padding: 16px 0;
      font-size: 1.6rem;
      font-weight: 700;
      font-family: inherit;
      cursor: pointer;
      letter-spacing: 0.03em;
      animation: answerPulse 1.4s ease-out infinite alternate;
      -webkit-tap-highlight-color: transparent;
      opacity: 0;
      transition: opacity 0.4s ease, transform 0.12s ease;
    }
    #answer-btn.visible { opacity: 1; }
    #answer-btn:active { transform: translateX(-50%) scale(0.96); }
  </style>
</head>
<body>

  <button id="back-btn" onclick="window.location.href='/dashboard'">
    <svg width="13" height="22" viewBox="0 0 10 17" fill="none">
      <path d="M9 1L1.5 8.5L9 16" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>
  </button>

  <div id="spinner"></div>
  <div id="category-label">Your Category is<span id="dots" class="dots"></span></div>
  <div id="category-text"></div>

  <button id="answer-btn">Answer</button>

  <script>
    const params = new URLSearchParams(location.search);
    const gameId = params.get('id');
    const userId = localStorage.getItem('userId');

    const spinner     = document.getElementById('spinner');
    const labelEl     = document.getElementById('category-label');
    const dotsEl      = document.getElementById('dots');
    const categoryEl  = document.getElementById('category-text');
    const answerBtn   = document.getElementById('answer-btn');

    const toTitleCase = str => str.toLowerCase().replace(/(?<!['\u2019])\b\w/g, c => c.toUpperCase());

    async function loadGame() {
      const loadStart = Date.now();
      try {
        const url = `/api/games?gameId=${gameId}${userId ? '&userId=' + userId : ''}`;
        const res  = await fetch(url);
        const game = await res.json();
        const category = toTitleCase(game.current_question?.category || '—');

        // Enforce minimum 500ms spinner
        const elapsed = Date.now() - loadStart;
        await new Promise(r => setTimeout(r, Math.max(0, 500 - elapsed)));

        // Fade out spinner
        spinner.classList.add('hidden');

        // 200ms later: "Your Category is..." label with animated dots
        setTimeout(() => {
          labelEl.classList.add('visible');

          // Animate "" → . → .. → ... at 330ms/step, 2.25–3.75 random cycles
          const cycles = 2.25 + Math.random() * 1.5;
          const totalSteps = Math.round(cycles * 4);
          let step = 0;
          dotsEl.textContent = '';
          const dotsInterval = setInterval(() => {
            step++;
            dotsEl.textContent = '.'.repeat(step % 4);
            if (step >= totalSteps - 1) {
              clearInterval(dotsInterval);
              // Cross-fade: label out, category in simultaneously
              labelEl.classList.remove('visible');
              categoryEl.textContent = category;
              categoryEl.classList.add('visible');
              // 1500ms later: Answer button
              setTimeout(() => answerBtn.classList.add('visible'), 1500);
            }
          }, 330);
        }, 200);

      } catch (err) {
        console.error('Failed to load game:', err);
      }
    }

    loadGame();
  </script>
</body>
</html>
